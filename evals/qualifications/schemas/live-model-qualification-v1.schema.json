{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.local/evals/qualifications/schemas/live-model-qualification-v1.schema.json",
  "title": "Grimodex Live Model Qualification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "qualificationId",
    "manifestDigest",
    "runId",
    "candidate",
    "configuration",
    "selectedSuites",
    "startedAt",
    "completedAt",
    "result",
    "reasons",
    "suites"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "qualificationId": { "const": "grimodex-live-model-qualification" },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha", "dirty"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoningEffort"],
      "properties": {
        "provider": { "type": ["string", "null"], "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "reasoningEffort": {
          "type": ["string", "null"],
          "enum": ["minimal", "low", "medium", "high", null]
        }
      }
    },
    "selectedSuites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "result": {
      "type": "string",
      "enum": ["QUALIFIED", "HOLD", "FAILED", "INCOMPLETE"]
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suites": {
      "type": "array",
      "items": { "$ref": "#/$defs/suiteResult" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": { "enum": ["QUALIFIED", "HOLD", "FAILED"] }
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": {
                "enum": ["minimal", "low", "medium", "high"]
              }
            }
          },
          "suites": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "QUALIFIED" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "suites": {
            "items": {
              "properties": { "result": { "const": "QUALIFIED" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "suiteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "startedAt",
        "completedAt",
        "exitCode",
        "commandDigest",
        "stdoutDigest",
        "stderrDigest",
        "sanitizedArtifactDigest",
        "result",
        "message"
      ],
      "properties": {
        "suiteId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "exitCode": { "type": ["integer", "null"] },
        "commandDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stdoutDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stderrDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sanitizedArtifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result": {
          "type": "string",
          "enum": ["QUALIFIED", "HOLD", "FAILED"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
