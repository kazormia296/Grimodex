{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.local/evals/narrative/schemas/case-v1.schema.json",
  "title": "Grimodex Narrative Extraction Evaluation Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "locale",
    "timezone",
    "frozenTime",
    "coverage",
    "documents",
    "expected",
    "criticalViolationClasses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^chronicle\\.micro\\.[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice", "tier"],
      "properties": {
        "slice": {
          "const": "chronicle"
        },
        "tier": {
          "const": "micro"
        }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "frozenTime": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "criticalViolationClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criticalViolationClass"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "includedDocumentIds", "omittedDocumentIds"],
      "properties": {
        "mode": {
          "enum": ["complete", "partial"]
        },
        "includedDocumentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "omittedDocumentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "complete"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "omittedDocumentIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "partial"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "omittedDocumentIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "quote"],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/identifier"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventDetection": {
          "type": "boolean"
        },
        "actuality": {
          "enum": [
            "actual",
            "attempted",
            "planned",
            "rumored",
            "dreamed",
            "hypothetical"
          ]
        },
        "attribution": {
          "type": "string",
          "pattern": "^(?:narrator|character:[a-z0-9]+(?:-[a-z0-9]+)*|document:[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        "narrativeFrame": {
          "enum": [
            "story-world",
            "flashback",
            "dream",
            "hypothetical",
            "reported"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "clustering": {
          "$ref": "#/$defs/identifier"
        },
        "significance": {
          "enum": ["major", "minor", "incidental", "none"]
        },
        "proposalGate": {
          "enum": ["propose", "suppress"]
        }
      },
      "minProperties": 1
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticKey", "dimensions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "semanticKey": {
          "$ref": "#/$defs/identifier"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        }
      }
    },
    "observationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectation"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectation"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": {
          "$ref": "#/$defs/observationSet"
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "criticalViolationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "match"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semanticKey", "dimension", "value"],
          "properties": {
            "semanticKey": {
              "$ref": "#/$defs/identifier"
            },
            "dimension": {
              "enum": [
                "eventDetection",
                "actuality",
                "attribution",
                "narrativeFrame",
                "evidence",
                "clustering",
                "significance",
                "proposalGate"
              ]
            },
            "value": {}
          }
        }
      }
    }
  }
}
