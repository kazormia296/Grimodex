{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.local/evals/certifications/schemas/gate-b2-journey-evidence-v1.schema.json",
  "title": "Gate B2 Journey Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeyId", "result", "startedAt", "completedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journeyId": { "type": "string" },
    "result": { "type": "string", "enum": ["passed", "failed", "blocked", "hold"] },
    "startedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "message": { "type": "string" },
    "artifactDigests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  }
}
