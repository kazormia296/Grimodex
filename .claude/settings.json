{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:fix)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest *)",
      "Bash(cd src-tauri && cargo check)",
      "Bash(cd src-tauri && cargo test *)",
      "Bash(cd src-tauri && cargo clippy *)",
      "Bash(cd src-tauri && cargo fmt *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(tauri build *--release*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./docs/**)",
      "Write(README.md)",
      "Write(CLAUDE.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "printf '\\a'"
        }]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [{
          "type": "command",
          "command": "printf '\\a'"
        }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "cmd=$(cat | jq -r '.tool_input.command // \"\"' 2>/dev/null); if echo \"$cmd\" | grep -qE 'rm -rf|sudo|tauri build.*--release'; then echo 'Blocked: dangerous command' >&2; exit 2; fi; exit 0"
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{
          "type": "command",
          "command": "f=$(cat | jq -r '.tool_input.file_path // \"\"'); if echo \"$f\" | grep -q '\\.rs$'; then (cd src-tauri && cargo fmt -- \"$f\" 2>/dev/null); elif echo \"$f\" | grep -qE '\\.(ts|tsx)$'; then npx prettier --write \"$f\" 2>/dev/null; fi; exit 0"
        }]
      }
    ]
  }
}
