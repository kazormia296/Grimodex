{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:fix)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm test *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm tauri *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest *)",
      "Bash(cd src-tauri && cargo check)",
      "Bash(cd src-tauri && cargo test *)",
      "Bash(cd src-tauri && cargo clippy *)",
      "Bash(cd src-tauri && cargo fmt *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(pip install *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(tauri build *--release*)",
      "Bash(cat *.env*)",
      "Bash(cat **/.env*)",
      "Bash(source *.env*)",
      "Bash(source **/.env*)",
      "Bash(. *.env*)",
      "Bash(export *SECRET*)",
      "Bash(export *TOKEN*)",
      "Bash(export *API_KEY*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git apply *)",
      "Bash(git apply)",
      "Bash(git am *)",
      "Bash(git am)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(sed -i *)",
      "Bash(perl -i *)",
      "Bash(patch *)",
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials*.json)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/secrets.*)",
      "Write(./docs/**)",
      "Write(README.md)",
      "Write(CLAUDE.md)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.github/workflows/**)",
      "Edit(**/.github/workflows/**)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(cat | jq -r '.tool_input.command // \"\"' 2>/dev/null); if echo \"$cmd\" | grep -qE 'rm -rf|sudo|tauri build.*--release'; then echo 'Blocked: dangerous command' >&2; exit 2; fi; exit 0"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-sensitive-bash-reads.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-push-to-main.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-sensitive-bash-writes.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(cat | jq -r '.tool_input.file_path // \"\"'); if echo \"$f\" | grep -q '\\.rs$'; then (cd src-tauri && cargo fmt -- \"$f\" 2>/dev/null); elif echo \"$f\" | grep -qE '\\.(ts|tsx|css)$'; then npx prettier --write \"$f\" 2>/dev/null; fi; exit 0"
          }
        ]
      }
    ]
  }
}
