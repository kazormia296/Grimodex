{
  "version": 1,
  "description": "Pull-request lane skipping for .github/workflows/ci.yml (first stage). A lane is skipped only when EVERY changed path is in that lane's neutral sets (or, for trigger lanes, when NO changed path is a trigger). Anything unclassified, incomplete, empty, or outside pull_request runs every lane.",
  "forceAll": [
    ".github/workflows/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "patches/**",
    "**/Cargo.lock",
    "**/Cargo.toml",
    ".cargo/**",
    "electron-builder.yml",
    "scripts/local-ci-registry.json",
    "scripts/impact/**",
    "scripts/ci-change-scope.*",
    "electron/**"
  ],
  "sets": {
    "docs": [
      "docs/**",
      "*.md",
      "public/RELEASE_NOTES/**",
      "experiments/**"
    ],
    "ci-and-ai": [
      "scripts/quality/**",
      "scripts/local-ci*",
      ".agents/**",
      ".claude/**",
      "policies/quality/**",
      "evals/quality-manifest.yaml",
      "evals/impact-map.yaml"
    ]
  },
  "lanes": {
    "journeys": {
      "mode": "neutral",
      "neutral": ["docs"],
      "neverNeutral": ["AGENTS.md"],
      "gatedJobs": [
        "electron-product-journeys-build",
        "electron-product-journeys-c2zc"
      ],
      "cascadeJobs": [
        "electron-product-journeys",
        "electron-product-journeys-aggregate",
        "electron-runtime-performance"
      ]
    },
    "rust": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "gatedJobs": ["rust", "nir1-c-query-worker"]
    },
    "native": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "neverNeutral": [
        "scripts/quality/run-nir1-retrieval.mjs",
        "scripts/quality/nir1-retrieval/**",
        "scripts/quality/nir1-graph-eval/**",
        "scripts/local-ci*"
      ],
      "gatedJobs": ["electron-native"]
    },
    "migration": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "gatedJobs": ["migration-recovery-gate"]
    },
    "windows": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "neverNeutral": ["LICENSING.md", "scripts/local-ci*"],
      "gatedJobs": ["electron-windows-installer-contract"]
    },
    "browser": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "gatedJobs": ["browser", "webgl", "storybook"]
    },
    "lfm": {
      "mode": "trigger",
      "triggers": ["experiments/lfm25-encoder-phase0/**"],
      "gatedJobs": ["lfm-encoder-phase0"]
    },
    "security": {
      "mode": "neutral",
      "neutral": ["docs", "ci-and-ai"],
      "gatedJobs": ["security"]
    }
  }
}
