{
  "version": 1,
  "defaultBase": "origin/master",
  "profiles": {
    "quick": ["impact"],
    "full": [
      "bootstrap",
      "migration-recovery-gate",
      "security",
      "frontend",
      "browser",
      "electron-native",
      "c2-zc-rust-acceptance-gate",
      "c2-zc-restore-fixture-builder",
      "quality",
      "electron-product-journeys",
      "lfm-encoder-phase0",
      "rust",
      "webgl",
      "storybook",
      "electron",
      "electron-runtime-performance"
    ]
  },
  "stages": {
    "impact": {
      "label": "Impact-selected local checks",
      "commands": [
        {
          "label": "Select and run affected Light suites",
          "command": "pnpm",
          "args": ["eval:impact", "--"],
          "comparison": true,
          "id": "impact.select"
        }
      ]
    },
    "bootstrap": {
      "label": "Locked local dependencies",
      "commands": [
        {
          "label": "Verify pnpm lockfile and dependencies",
          "command": "pnpm",
          "args": ["install", "--frozen-lockfile"],
          "id": "bootstrap.install"
        },
        {
          "label": "Install pinned Electron binary",
          "command": "node",
          "args": ["scripts/ensure-electron-binary.mjs"],
          "id": "bootstrap.electron-binary",
          "after": ["bootstrap.install"],
          "timeoutMs": 180000,
          "obligations": []
        },
        {
          "label": "Build shared workspace dependencies",
          "command": "pnpm",
          "args": ["build:workspace:dependencies"],
          "id": "bootstrap.workspace-build",
          "after": ["bootstrap.install"],
          "lane": "workspace-build",
          "slots": 2
        },
        {
          "label": "Ensure Playwright Chromium is available",
          "command": "pnpm",
          "args": ["exec", "playwright", "install", "chromium"],
          "id": "bootstrap.chromium",
          "after": ["bootstrap.install"],
          "lane": "browser"
        }
      ]
    },
    "quality": {
      "label": "Quality contracts and evaluation fixtures",
      "env": {
        "GATE_B2_WORKTREE_SMOKE": "1"
      },
      "commands": [
        {
          "label": "Canonical quality workflow",
          "command": "pnpm",
          "args": ["ci:verify:quality"],
          "id": "quality.contracts",
          "after": ["bootstrap.workspace-build"],
          "slots": 4
        }
      ]
    },
    "frontend": {
      "label": "Frontend checks and production artifact",
      "commands": [
        {
          "label": "Renderer unit tests (shard 1/3)",
          "command": "pnpm",
          "args": [
            "exec",
            "vitest",
            "--config",
            "vitest.config.ts",
            "--run",
            "--maxWorkers",
            "2",
            "--shard",
            "1/3"
          ],
          "id": "frontend.unit-shard-1",
          "after": ["bootstrap.workspace-build"],
          "slots": 2,
          "obligations": []
        },
        {
          "label": "Renderer unit tests (shard 2/3)",
          "command": "pnpm",
          "args": [
            "exec",
            "vitest",
            "--config",
            "vitest.config.ts",
            "--run",
            "--maxWorkers",
            "2",
            "--shard",
            "2/3"
          ],
          "id": "frontend.unit-shard-2",
          "after": ["bootstrap.workspace-build"],
          "slots": 2,
          "obligations": []
        },
        {
          "label": "Renderer unit tests (shard 3/3)",
          "command": "pnpm",
          "args": [
            "exec",
            "vitest",
            "--config",
            "vitest.config.ts",
            "--run",
            "--maxWorkers",
            "2",
            "--shard",
            "3/3"
          ],
          "id": "frontend.unit",
          "after": ["bootstrap.workspace-build"],
          "slots": 2
        },
        {
          "label": "Renderer type-check",
          "command": "pnpm",
          "args": ["exec", "tsc", "--noEmit"],
          "id": "frontend.typecheck",
          "after": ["bootstrap.workspace-build"]
        },
        {
          "label": "Renderer lint",
          "command": "pnpm",
          "args": ["lint"],
          "id": "frontend.lint",
          "after": ["bootstrap.workspace-build"]
        },
        {
          "label": "Architecture baseline",
          "command": "pnpm",
          "args": ["validate:architecture"],
          "id": "frontend.architecture",
          "after": ["bootstrap.workspace-build"]
        },
        {
          "label": "Browser CI performance contracts",
          "command": "pnpm",
          "args": ["test:browser-ci"],
          "id": "frontend.browser-contracts",
          "after": ["bootstrap.workspace-build"],
          "slots": 2
        },
        {
          "label": "Web Editor production artifact",
          "command": "pnpm",
          "args": [
            "exec",
            "vite",
            "build",
            "--mode",
            "web-editor",
            "--outDir",
            ".artifacts/local-ci/runs/__LOCAL_CI_RUN_ID__/web-editor"
          ],
          "id": "frontend.web-build",
          "after": ["bootstrap.workspace-build"],
          "slots": 2
        }
      ]
    },
    "lfm-encoder-phase0": {
      "label": "LFM encoder offline contracts",
      "commands": [
        {
          "label": "Sync fixed CPU environment",
          "command": "uv",
          "args": ["sync", "--frozen", "--extra", "cpu"],
          "cwd": "experiments/lfm25-encoder-phase0",
          "id": "lfm.setup",
          "after": ["bootstrap.install"],
          "lane": "lfm",
          "slots": 2
        },
        {
          "label": "LFM unit and contract tests",
          "command": "uv",
          "args": ["run", "--frozen", "--extra", "cpu", "pytest"],
          "cwd": "experiments/lfm25-encoder-phase0",
          "id": "lfm.tests",
          "after": ["lfm.setup"],
          "lane": "lfm",
          "slots": 4
        },
        {
          "label": "Public dataset contracts",
          "command": "uv",
          "args": [
            "run",
            "--frozen",
            "--extra",
            "cpu",
            "python",
            "tools/validate_dataset.py",
            "data/public"
          ],
          "cwd": "experiments/lfm25-encoder-phase0",
          "id": "lfm.dataset",
          "after": ["lfm.tests"],
          "lane": "lfm",
          "slots": 2
        }
      ]
    },
    "browser": {
      "label": "Browser tests",
      "commands": [
        {
          "label": "Browser suite with resource metrics",
          "command": "pnpm",
          "args": [
            "benchmark:browser-ci",
            "--",
            "--suite",
            "browser",
            "--runs",
            "1",
            "--max-workers",
            "2",
            "--output",
            ".artifacts/browser-ci/browser.json"
          ],
          "id": "browser.tests",
          "after": ["bootstrap.workspace-build", "bootstrap.chromium"],
          "lane": "browser",
          "slots": 2
        }
      ]
    },
    "webgl": {
      "label": "Deterministic WebGL checks",
      "commands": [
        {
          "label": "Zen shader WebGL contracts",
          "command": "pnpm",
          "args": ["test:zen-shader-webgl", "--run"],
          "id": "webgl.zen",
          "after": ["bootstrap.workspace-build", "bootstrap.chromium"],
          "lane": "browser"
        },
        {
          "label": "WebGL suite with resource metrics",
          "command": "pnpm",
          "args": [
            "benchmark:browser-ci",
            "--",
            "--suite",
            "webgl",
            "--runs",
            "1",
            "--file-parallelism",
            "false",
            "--max-workers",
            "1",
            "--output",
            ".artifacts/browser-ci/webgl.json"
          ],
          "id": "webgl.tests",
          "after": ["webgl.zen"],
          "lane": "browser"
        }
      ]
    },
    "storybook": {
      "label": "Storybook browser checks",
      "commands": [
        {
          "label": "Storybook suite with resource metrics",
          "command": "pnpm",
          "args": [
            "benchmark:browser-ci",
            "--",
            "--suite",
            "storybook",
            "--runs",
            "1",
            "--output",
            ".artifacts/browser-ci/storybook.json"
          ],
          "id": "storybook.tests",
          "after": ["bootstrap.workspace-build", "bootstrap.chromium"],
          "lane": "browser",
          "slots": 2
        }
      ]
    },
    "security": {
      "label": "Dependency and license security checks",
      "commands": [
        {
          "label": "pnpm high-severity audit",
          "command": "pnpm",
          "args": [
            "dlx",
            "pnpm@11.13.0",
            "--pm-on-fail=ignore",
            "audit",
            "--audit-level",
            "high"
          ],
          "id": "security.pnpm-audit",
          "after": ["bootstrap.install"]
        },
        {
          "label": "Shared Rust dependency audit",
          "command": "cargo",
          "args": ["audit", "--file", "src-tauri/Cargo.lock"],
          "id": "security.shared-rust-audit",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared"
        },
        {
          "label": "Electron native dependency audit",
          "command": "cargo",
          "args": [
            "audit",
            "--file",
            "electron/native/grimodex-node/Cargo.lock"
          ],
          "id": "security.native-rust-audit",
          "after": ["bootstrap.install"],
          "lane": "cargo-native"
        }
      ]
    },
    "electron": {
      "label": "Electron contracts, tests, and production build",
      "commands": [
        {
          "label": "Electron type-check",
          "command": "pnpm",
          "args": ["exec", "tsc", "-p", "electron/tsconfig.json", "--noEmit"],
          "id": "electron.typecheck",
          "after": ["bootstrap.workspace-build"]
        },
        {
          "label": "Electron production build",
          "command": "pnpm",
          "args": ["ci:build:desktop"],
          "id": "electron.build",
          "after": ["electron.typecheck"],
          "slots": 2
        },
        {
          "label": "Renderer performance budget",
          "command": "pnpm",
          "args": ["perf:budget"],
          "id": "electron.budget",
          "after": ["electron.build"]
        },
        {
          "label": "Release workflow and manifest contracts",
          "command": "node",
          "args": [
            "--test",
            "--test-concurrency=4",
            "scripts/validate-release-version.test.mjs",
            "scripts/resolve-release-workflow.test.mjs",
            "scripts/compose-github-release-notes.test.mjs",
            "scripts/generate-tauri-bridge-manifest.test.mjs",
            "scripts/release-workflows.test.mjs",
            "scripts/arch-electron-package.test.mjs",
            "scripts/linux-release-abi.test.mjs",
            "scripts/verify-electron-updater-metadata.test.mjs",
            "scripts/windows-release-workflow.test.mjs",
            "scripts/electron-v2-cleanup.test.mjs",
            "scripts/electron-runtime-performance-workflow.test.mjs",
            "scripts/impact/core.test.mjs",
            "scripts/product-journey-impact.test.mjs",
            "scripts/product-journey-ratchet-hardening.test.mjs",
            "scripts/product-journey-explicit-all.test.mjs",
            "scripts/product-journey-backlog.test.mjs",
            "scripts/product-journey-mcp-client.test.mjs",
            "scripts/electron-product-journey-results.test.mjs",
            "scripts/electron-product-journey-cleanup-results.test.mjs",
            "scripts/electron-product-journeys.test.mjs",
            "electron/scripts/product-journey-shards.test.mjs",
            "scripts/codex-entity-relation-product-journey.test.mjs",
            "scripts/generate-licenses.test.mjs",
            "scripts/license-policy.test.mjs",
            "scripts/semantic-reranker-release.test.mjs"
          ],
          "id": "electron.contracts",
          "after": ["bootstrap.workspace-build"],
          "slots": 4
        },
        {
          "label": "Electron unit tests",
          "command": "pnpm",
          "args": ["test:electron", "--run", "--maxWorkers", "4"],
          "id": "electron.unit",
          "after": ["bootstrap.workspace-build"],
          "slots": 4
        }
      ]
    },
    "electron-native": {
      "label": "Electron native and MCP checks",
      "env": {
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "CARGO_PROFILE_TEST_DEBUG": "0"
      },
      "commands": [
        {
          "label": "Build development N-API module",
          "command": "pnpm",
          "args": ["napi:build"],
          "id": "native.build",
          "after": ["bootstrap.install"],
          "lane": "cargo-native",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4"
          }
        },
        {
          "label": "Test N-API public boundary",
          "command": "pnpm",
          "args": [
            "--dir",
            "electron/native/grimodex-node",
            "test",
            "--test-concurrency=4"
          ],
          "id": "native.public-tests",
          "after": ["native.build"],
          "lane": "cargo-native",
          "slots": 4
        },
        {
          "label": "Check release-only native features",
          "command": "cargo",
          "args": [
            "check",
            "--manifest-path",
            "electron/native/grimodex-node/Cargo.toml",
            "--features",
            "licensing,legacy-keyring-migration"
          ],
          "id": "native.check",
          "after": ["bootstrap.install"],
          "lane": "cargo-native",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4"
          }
        },
        {
          "label": "Clippy release-only native features",
          "command": "cargo",
          "args": [
            "clippy",
            "--manifest-path",
            "electron/native/grimodex-node/Cargo.toml",
            "--all-targets",
            "--features",
            "licensing,legacy-keyring-migration",
            "--",
            "-D",
            "warnings"
          ],
          "id": "native.clippy",
          "after": ["bootstrap.install"],
          "lane": "cargo-native",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4"
          }
        },
        {
          "label": "Test release-only native features",
          "command": "cargo",
          "args": [
            "test",
            "--manifest-path",
            "electron/native/grimodex-node/Cargo.toml",
            "--features",
            "licensing,legacy-keyring-migration"
          ],
          "id": "native.tests",
          "after": ["bootstrap.install"],
          "lane": "cargo-native",
          "slots": 2,
          "timeoutMs": 900000,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Test licensed MCP sidecar",
          "command": "cargo",
          "args": [
            "test",
            "--manifest-path",
            "src-tauri/Cargo.toml",
            "-p",
            "grimodex-mcp",
            "--features",
            "licensing"
          ],
          "id": "native.mcp-tests",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4",
            "RUST_TEST_THREADS": "4"
          }
        }
      ]
    },
    "rust": {
      "label": "Shared Rust crates",
      "env": {
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "CARGO_PROFILE_TEST_DEBUG": "0"
      },
      "commands": [
        {
          "label": "Migration supervisor failpoints",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--features",
            "test-failpoints",
            "--test",
            "workspace_migration_supervisor"
          ],
          "cwd": "src-tauri",
          "id": "rust.supervisor-failpoints",
          "after": ["bootstrap.install"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": [
            "rust.supervisor-failpoints",
            "migration.supervisor-failpoints"
          ]
        },
        {
          "label": "Shared Rust DB integration and schema-contract tests",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--test",
            "*",
            "--bin",
            "schema-contract"
          ],
          "cwd": "src-tauri",
          "id": "rust.tests-db-integrations",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared-db-integrations",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "Shared Rust DB library tests",
          "command": "cargo",
          "args": ["test", "-p", "grimodex-db", "--lib"],
          "cwd": "src-tauri",
          "id": "rust.tests-db-lib",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared-db-lib",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "NIR-1 capacity diagnostics and fixture tests",
          "command": "cargo",
          "args": ["test", "-p", "grimodex-db", "--features", "nir1-material-diagnostics", "--lib", "narrative_extraction::nir1_capacity"],
          "cwd": "src-tauri",
          "id": "rust.tests-db-nir1-capacity",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared-db-capacity",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "NIR-1 capacity binary integration tests",
          "command": "cargo",
          "args": ["test", "-p", "grimodex-db", "--features", "nir1-material-diagnostics", "--test", "nir1_capacity_binary"],
          "cwd": "src-tauri",
          "id": "rust.tests-db-nir1-capacity-binary",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared-db-capacity-binary",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "Shared Rust non-DB workspace tests and doctests",
          "command": "cargo",
          "args": [
            "test",
            "--workspace",
            "--exclude",
            "grimodex",
            "--exclude",
            "grimodex-db",
            "--features",
            "grimodex-semantic/semantic-embedding"
          ],
          "cwd": "src-tauri",
          "id": "rust.tests-other-workspace",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared-other-workspace",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "Shared Rust check",
          "command": "cargo",
          "args": [
            "check",
            "--workspace",
            "--exclude",
            "grimodex",
            "--features",
            "grimodex-semantic/semantic-embedding"
          ],
          "cwd": "src-tauri",
          "id": "rust.check",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4"
          }
        },
        {
          "label": "Shared Rust clippy",
          "command": "cargo",
          "args": [
            "clippy",
            "--workspace",
            "--exclude",
            "grimodex",
            "--all-targets",
            "--features",
            "grimodex-semantic/semantic-embedding",
            "--",
            "-D",
            "warnings"
          ],
          "cwd": "src-tauri",
          "id": "rust.clippy",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4"
          }
        },
        {
          "label": "Shared Rust DB doctests",
          "command": "cargo",
          "args": ["test", "-p", "grimodex-db", "--doc"],
          "cwd": "src-tauri",
          "id": "rust.tests-db-doctests",
          "after": ["rust.tests-db-lib"],
          "lane": "cargo-shared-db-lib",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          },
          "obligations": []
        },
        {
          "label": "Compile every shared Rust test target",
          "command": "cargo",
          "args": [
            "test",
            "--workspace",
            "--exclude",
            "grimodex",
            "--features",
            "grimodex-semantic/semantic-embedding",
            "--no-run"
          ],
          "cwd": "src-tauri",
          "id": "rust.tests",
          "after": [
            "rust.tests-db-lib",
            "rust.tests-db-integrations",
            "rust.tests-db-nir1-capacity",
            "rust.tests-db-nir1-capacity-binary",
            "rust.tests-other-workspace",
            "rust.tests-db-doctests"
          ],
          "lane": "cargo-shared",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2"
          },
          "obligations": ["rust.tests"]
        },
        {
          "label": "Narrative runtime authority",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--test",
            "narrative_runtime_authority"
          ],
          "cwd": "src-tauri",
          "id": "rust.runtime-authority",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4",
            "RUST_TEST_THREADS": "4"
          }
        },
        {
          "label": "Licensed runtime",
          "command": "cargo",
          "args": ["test", "-p", "grimodex-license", "--features", "licensing"],
          "cwd": "src-tauri",
          "id": "rust.license",
          "after": ["bootstrap.install"],
          "lane": "cargo-shared",
          "slots": 4,
          "env": {
            "CARGO_BUILD_JOBS": "4",
            "RUST_TEST_THREADS": "4"
          }
        }
      ]
    },
    "c2-zc-rust-acceptance-gate": {
      "label": "Candidate-bound C2-ZC Rust acceptance receipt",
      "env": {
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "CARGO_PROFILE_TEST_DEBUG": "0",
        "GRIMODEX_C2ZC_RUST_RECEIPT_PATH": ".artifacts/local-ci/c2-zc-rust-acceptance.json",
        "GRIMODEX_C2ZC_RUST_REQUESTED_BASE": "origin/master",
        "GRIMODEX_C2ZC_RUST_REQUESTED_HEAD": "HEAD"
      },
      "commands": [
        {
          "label": "Run exact C2-ZC Rust acceptance gates",
          "command": "node",
          "args": [
            "scripts/c2zc-rust-acceptance-receipt.mjs",
            "--output",
            ".artifacts/local-ci/c2-zc-rust-acceptance.json"
          ],
          "cwd": ".",
          "id": "c2zc.rust-acceptance",
          "after": ["rust.supervisor-failpoints"],
          "lane": "cargo-shared",
          "slots": 12,
          "timeoutMs": 240000,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        }
      ]
    },
    "c2-zc-restore-fixture-builder": {
      "label": "Candidate-bound C2-ZC offline restore fixture",
      "env": {
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "CARGO_PROFILE_TEST_DEBUG": "0"
      },
      "commands": [
