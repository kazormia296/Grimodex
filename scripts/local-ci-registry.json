            "run",
            "-p",
            "grimodex-db",
            "--manifest-path",
            "src-tauri/Cargo.toml",
            "--features",
            "c2zc-fixture-builder",
            "--bin",
            "c2zc-restore-fixture",
            "--",
            "build",
            "--repo-root",
            ".",
            "--output-dir",
            "__C2ZC_RESTORE_FIXTURE_OUTPUT_DIR__",
            "--candidate",
            "HEAD",
            "--expected-head",
            "__C2ZC_RESTORE_FIXTURE_EXPECTED_HEAD__",
            "--expected-tree",
            "__C2ZC_RESTORE_FIXTURE_EXPECTED_TREE__"
          ],
          "cwd": ".",
          "id": "c2zc.fixture-build",
          "after": ["c2zc.rust-acceptance"],
          "lane": "cargo-shared",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2"
          }
        },
        {
          "label": "Verify C2-ZC offline restore fixture",
          "command": "cargo",
          "args": [
            "run",
            "-p",
            "grimodex-db",
            "--manifest-path",
            "src-tauri/Cargo.toml",
            "--features",
            "c2zc-fixture-builder",
            "--bin",
            "c2zc-restore-fixture",
            "--",
            "verify",
            "--manifest",
            "__C2ZC_RESTORE_FIXTURE_MANIFEST__",
            "--repo-root",
            ".",
            "--candidate",
            "HEAD"
          ],
          "cwd": ".",
          "id": "c2zc.fixture-verify",
          "after": ["c2zc.fixture-build"],
          "lane": "cargo-shared",
