    "migration-recovery-gate": {
      "label": "Migration recovery checks",
      "env": {
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "CARGO_PROFILE_TEST_DEBUG": "0"
      },
      "commands": [
        {
          "label": "Migration supervisor integration",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--test",
            "workspace_migration_supervisor"
          ],
          "cwd": "src-tauri",
          "id": "migration.supervisor",
          "after": ["rust.supervisor-failpoints"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Migration recovery failpoint library tests",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--features",
            "test-failpoints",
            "--lib"
          ],
          "cwd": "src-tauri",
          "id": "migration.failpoints-lib",
          "after": ["migration.supervisor"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Safe Mode structured outcome",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--features",
            "test-failpoints",
            "--test",
            "workspace_safe_mode_outcome"
          ],
          "cwd": "src-tauri",
          "id": "migration.safe-mode",
          "after": ["migration.failpoints-lib"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Release-schema migration fixture",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--test",
            "release_schema_migration"
          ],
          "cwd": "src-tauri",
          "id": "migration.release-schema",
          "after": ["migration.safe-mode"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Subprocess crash recovery",
          "command": "cargo",
          "args": [
            "test",
            "-p",
            "grimodex-db",
            "--features",
            "test-failpoints",
            "--test",
            "migration_subprocess_crash",
            "--test",
            "restore_subprocess_crash"
          ],
          "cwd": "src-tauri",
          "id": "migration.crash",
          "after": ["migration.release-schema"],
          "lane": "cargo-recovery",
          "slots": 2,
          "env": {
            "CARGO_BUILD_JOBS": "2",
            "RUST_TEST_THREADS": "2"
          }
        },
        {
          "label": "Safe Mode IPC contract",
          "command": "pnpm",
          "args": [
            "test:electron",
            "--run",
            "electron/shared/ipcContract.test.ts"
          ],
          "id": "migration.ipc",
          "after": ["migration.crash"],
          "slots": 2
        },
        {
          "label": "Recovery Shell frontend tests",
          "command": "pnpm",
          "args": [
            "exec",
            "vitest",
            "--run",
            "--maxWorkers",
            "4",
            "src/features/workspace/store.test.ts",
            "src/features/workspace/recovery/RecoveryShell.test.tsx"
          ],
          "id": "migration.ui",
          "after": ["migration.ipc"],
          "slots": 4
        }
      ]
