    "harnessChoices": [
      {
        "id": "project-title",
        "value": "NIR-1 <caseId>/<variantId>",
        "reason": "fixture は project の title を宣言しない。R／IR の query は問いの Scene の本文を読み、project の title を読まない"
      },
      {
        "id": "phase-resolution-mode",
        "value": "reading",
        "reason": "dev の setup-driver と P harness と同じ。fixture は story time を設定しないので、前後は reading 順で決まる（README の secret／reveal 行）"
      },
      {
        "id": "relation-label",
        "value": "label = relation type",
        "reason": "製品の relation.create は空でない label を要る。UI（CodexTypedRelationsSection）は入力の label から slugifyRelationType で型を作るので、型をそのまま label にすると UI と同じ行になる（fixture の型はどれも slugify で同じ文字列に戻る）"
      },
      {
        "id": "scene-runtime-ids",
        "value": "harness が UUID を発行して writer に渡し、受領書で対応付ける",
        "reason": "README :36（runtime ID は setup receipt で対応付け、Gold には書かない）。S1 は G-01 の Scene の runtime ID を論理 ID と同じにしたが、K2/4 はそれを求めず（宣言は runtime の Scene ID に束縛され、addendum の Scene は論理 ID）、R／IR の score は本文から作り、G-01 の R と R+IR の期待値は 1 件なので ID の順に依らない（README :56）"
      },
      {
        "id": "ir-scene-folders",
        "value": "qualifiedIr を持つ Scene ごとに folder を 1 つ作る（論理 ID nir1-folder-<Scene の論理 ID>、title は包む Scene の title、位置はその Scene の読む順の位置、Scene は folder の中の a0）",
        "reason": "fixture に folder は無く、folder の論理 ID と title は fixture の値ではない harness の値。製品の Chronicle の抽出は folder 単位で動き、決定論の provider は citation window が 1 つであることを要る（Scene 1 つだけの folder）。24 件の setup（scripts/quality/setup-nir1-retrieval.mjs の folder の作成）と S1（g01-question を nir1-folder-g01-question に置いた）と同じ型。tree は最初の typed Revision の前に作り終える。folder の title が Raw に効かないことは確かめていない"
      },
      {
        "id": "g01-query-title",
        "value": "Current query scene",
        "reason": "G-01 の query は title を宣言しない。P harness（nir1-retrieval/renderer.ts）と同じ値。R／IR の query は問いの Scene の本文を読み、その title を読まない"
      },
      {
        "id": "g01-scope-refs",
        "value": "timeline:main / worldline:prime / layer:manuscript（S1 の SETUP_DECISIONS。holder と audience は reader）",
        "reason": "K2/4 :413 は R と R+IR の setup に S1 の setup の選択（C14 (d) の SETUP_DECISIONS。Scope の ref、query の Scene の title など）を使うとする。値は S1 の報告 §2.2 の写し（registry editor の placeholder）。候補 §7 :207-209 は ref の文字列を宣言しない"
      },
      {
        "id": "g01-setup-order",
        "value": "project → Scene（g01-question は folder の中）→ registry と明示 A1 → Entity と Relation → 唯一の pin → seed の pin → maintenance → typed Revision → Chronicle の IR（承認を最後）→ B の seal",
        "reason": "S1 の setup の順（session の seed → graph-input → graph-review → extract-and-review。S1 の SETUP_DECISIONS「書き込みの順序を固定し、Chronicle の承認を最後に置く」）に揃えた。唯一の pin と seed の pin を typed Revision の前に置くのは SP/1（確認済み）の置き場"
      },
      {
        "id": "g01-typed-revision",
        "value": "論理 ID g01-typed-revision（review Scene g01-review、Entity g01-orin と g01-mira-entity、Relation g01-handover、approved）",
        "reason": "候補 §7 :217-218 の typed Revision を 1 件に写した（ID は harness の名前）"
      }
    ],
