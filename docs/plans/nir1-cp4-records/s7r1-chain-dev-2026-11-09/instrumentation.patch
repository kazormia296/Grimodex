diff --git a/src-tauri/crates/grimodex-db/src/dev_trace.rs b/src-tauri/crates/grimodex-db/src/dev_trace.rs
new file mode 100644
index 00000000..7175c447
--- /dev/null
+++ b/src-tauri/crates/grimodex-db/src/dev_trace.rs
@@ -0,0 +1,308 @@
+//! DEV-ONLY observation (s7r1 chain instrumentation). Never merged.
+//!
+//! Inert unless the environment variable `GDX_DEV_TRACE_DIR` names a directory.
+//! When set, events are appended as JSON Lines to `<dir>/trace-<pid>.jsonl`
+//! (one small `write` per line, no fsync) and cumulative aggregates are written
+//! once per second by a background thread. It observes only: no product
+//! decision reads anything from here.
+//!
+//! Every line has `kind`, `pid`, `t_ms` (monotonic ms since this process first
+//! used the trace) and `wall` (UTC ISO-8601, ms).
+
+use std::cell::Cell;
+use std::panic::Location;
+use std::collections::HashMap;
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use serde_json::{json, Value};
+
+const ENV: &str = "GDX_DEV_TRACE_DIR";
+const CYCLE_HIST: usize = 9; // 0..=7 commits, 8 = 8 or more
+
+static DIR: OnceLock<Option<PathBuf>> = OnceLock::new();
+static START: OnceLock<Instant> = OnceLock::new();
+static FILE: OnceLock<Mutex<Option<File>>> = OnceLock::new();
+static FLUSHER: OnceLock<()> = OnceLock::new();
+/// Set by `init()` (called only by the worker process): that process emits
+/// lines only; it never starts the flusher, keeps maps, or counts waiters.
+static EMIT_ONLY: AtomicBool = AtomicBool::new(false);
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+/// Commits that reached the WAL through the main connection's `wal_hook`.
+static COMMITS: AtomicU64 = AtomicU64::new(0);
+static PREEMPTS: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Default)]
+struct LabelStat {
+    arrivals: u64,
+    wait_ns_total: u128,
+    wait_ns_max: u128,
+}
+
+#[derive(Default)]
+struct Inner {
+    labels: HashMap<String, LabelStat>,
+    active: HashMap<u64, (String, Instant)>,
+    last_acquirer: String,
+    preempt_kind: HashMap<String, u64>,
+    /// "<kind>|<label of a waiter that was present>" -> count
+    preempt_by: HashMap<String, u64>,
+    /// "<kind>|last-fg-acquirer:<label>" -> count (for `busy` with no waiter)
+    preempt_last_acquirer: HashMap<String, u64>,
+    cycles: u64,
+    cycles_with_preempt: u64,
+    cycle_commit_sum: u64,
+    cycle_commit_max: u64,
+    cycle_hist: [u64; CYCLE_HIST],
+    cycle_ns_max: u128,
+}
+
+static INNER: OnceLock<Mutex<Inner>> = OnceLock::new();
+
+fn inner() -> &'static Mutex<Inner> {
+    INNER.get_or_init(|| Mutex::new(Inner::default()))
+}
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+fn dir() -> Option<&'static PathBuf> {
+    DIR.get_or_init(|| {
+        std::env::var_os(ENV)
+            .filter(|v| !v.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_ref()
+}
+
+/// Open the file now (and start the clock). Call before any allocation-fenced
+/// scope in a process that emits from inside one.
+pub fn init() {
+    if enabled() {
+        EMIT_ONLY.store(true, Ordering::Relaxed);
+        emit("init", json!({}));
+    }
+}
+
+pub fn enabled() -> bool {
+    dir().is_some()
+}
+
+fn mono_ms() -> f64 {
+    START.get_or_init(Instant::now).elapsed().as_secs_f64() * 1000.0
+}
+
+/// Append one JSON line. No-op when the trace directory is not configured.
+pub fn emit(kind: &str, fields: Value) {
+    let Some(dir) = dir() else { return };
+    let mut line = json!({
+        "kind": kind,
+        "pid": std::process::id(),
+        "t_ms": mono_ms(),
+        "wall": chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true),
+    });
+    if let (Some(obj), Value::Object(extra)) = (line.as_object_mut(), fields) {
+        for (k, v) in extra {
+            obj.insert(k, v);
+        }
+    }
+    let mut text = line.to_string();
+    text.push('\n');
+    let slot = FILE.get_or_init(|| Mutex::new(None));
+    let mut guard = lock(slot);
+    if guard.is_none() {
+        let _ = std::fs::create_dir_all(dir);
+        *guard = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(dir.join(format!("trace-{}.jsonl", std::process::id())))
+            .ok();
+    }
+    if let Some(file) = guard.as_mut() {
+        let _ = file.write_all(text.as_bytes());
+    }
+}
+
+// ---- labels for foreground waiters ------------------------------------------
+
+thread_local! {
+    static LABEL: Cell<&'static str> = const { Cell::new("") };
+}
+
+pub struct LabelScope(&'static str);
+
+impl Drop for LabelScope {
+    fn drop(&mut self) {
+        LABEL.with(|l| l.set(self.0));
+    }
+}
+
+/// Name the foreground work of the current thread until the scope drops.
+pub fn label(name: &'static str) -> LabelScope {
+    LabelScope(LABEL.with(|l| l.replace(name)))
+}
+
+fn active() -> bool {
+    enabled() && !EMIT_ONLY.load(Ordering::Relaxed)
+}
+
+fn ensure_flusher() {
+    FLUSHER.get_or_init(|| {
+        let _ = std::thread::Builder::new()
+            .name("gdx-dev-trace".into())
+            .spawn(|| loop {
+                std::thread::sleep(Duration::from_secs(1));
+                emit("agg", aggregate());
+            });
+    });
+}
+
+fn aggregate() -> Value {
+    let g = lock(inner());
+    let labels: serde_json::Map<String, Value> = g
+        .labels
+        .iter()
+        .map(|(k, s)| {
+            (
+                k.clone(),
+                json!({
+                    "arrivals": s.arrivals,
+                    "waitMsTotal": s.wait_ns_total as f64 / 1e6,
+                    "waitMsMax": s.wait_ns_max as f64 / 1e6,
+                }),
+            )
+        })
+        .collect();
+    json!({
+        "commits": COMMITS.load(Ordering::Relaxed),
+        "preemptsTotal": PREEMPTS.load(Ordering::Relaxed),
+        "waiterLabels": labels,
+        "activeWaiters": g.active.len(),
+        "preemptKind": g.preempt_kind,
+        "preemptBy": g.preempt_by,
+        "preemptLastAcquirer": g.preempt_last_acquirer,
+        "cycles": g.cycles,
+        "cyclesWithPreempt": g.cycles_with_preempt,
+        "cycleCommitSum": g.cycle_commit_sum,
+        "cycleCommitMax": g.cycle_commit_max,
+        "cycleCommitHist": g.cycle_hist.to_vec(),
+        "cycleMsMax": g.cycle_ns_max as f64 / 1e6,
+    })
+}
+
+// ---- foreground waiter registry ----------------------------------------------
+
+/// Called when a foreground waiter is about to be announced. `site` is the
+/// outermost `#[track_caller]` call site (file:line). Returns an id for `waiter_exit`.
+pub fn waiter_enter(site: &'static Location<'static>) -> Option<u64> {
+    if !active() {
+        return None;
+    }
+    ensure_flusher();
+    let explicit = LABEL.with(|l| l.get());
+    let key = if explicit.is_empty() {
+        format!("caller:{}:{}", site.file(), site.line())
+    } else {
+        explicit.to_owned()
+    };
+    let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+    let mut g = lock(inner());
+    g.labels.entry(key.clone()).or_default().arrivals += 1;
+    g.active.insert(id, (key, Instant::now()));
+    Some(id)
+}
+
+pub fn waiter_exit(id: u64) {
+    let mut g = lock(inner());
+    if let Some((key, since)) = g.active.remove(&id) {
+        let ns = since.elapsed().as_nanos();
+        if let Some(stat) = g.labels.get_mut(&key) {
+            stat.wait_ns_total += ns;
+            stat.wait_ns_max = stat.wait_ns_max.max(ns);
+        }
+        g.last_acquirer = key;
+    }
+}
+
+/// A maintenance run was (or is about to be) preempted. `kind` says where.
+pub fn note_preempt(kind: &'static str) {
+    if !active() {
+        return;
+    }
+    ensure_flusher();
+    PREEMPTS.fetch_add(1, Ordering::Relaxed);
+    let mut g = lock(inner());
+    *g.preempt_kind.entry(kind.to_owned()).or_default() += 1;
+    let present: Vec<String> = g.active.values().map(|(k, _)| k.clone()).collect();
+    if present.is_empty() {
+        let last = g.last_acquirer.clone();
+        *g.preempt_last_acquirer
+            .entry(format!("{kind}|{last}"))
+            .or_default() += 1;
+    }
+    for key in present {
+        *g.preempt_by.entry(format!("{kind}|{key}")).or_default() += 1;
+    }
+}
+
+// ---- commit counting -----------------------------------------------------------
+
+/// Called from the WAL hook (every commit that wrote to the WAL). One atomic add.
+pub fn note_commit() {
+    COMMITS.fetch_add(1, Ordering::Relaxed);
+}
+
+pub struct CycleGuard {
+    start: Option<(u64, u64, Instant)>,
+}
+
+impl CycleGuard {
+    pub fn begin() -> Self {
+        if !active() {
+            return Self { start: None };
+        }
+        ensure_flusher();
+        Self {
+            start: Some((
+                COMMITS.load(Ordering::Relaxed),
+                PREEMPTS.load(Ordering::Relaxed),
+                Instant::now(),
+            )),
+        }
+    }
+}
+
+impl Drop for CycleGuard {
+    fn drop(&mut self) {
+        let Some((commits, preempts, since)) = self.start else {
+            return;
+        };
+        let delta = COMMITS.load(Ordering::Relaxed).saturating_sub(commits);
+        let preempted = PREEMPTS.load(Ordering::Relaxed) > preempts;
+        let ns = since.elapsed().as_nanos();
+        emit(
+            "cycle",
+            json!({
+                "ms": ns as f64 / 1e6,
+                "commits": delta,
+                "preempted": preempted,
+                "startedWallApprox": (chrono::Utc::now()
+                    - chrono::Duration::nanoseconds(ns.min(i64::MAX as u128) as i64))
+                .to_rfc3339_opts(chrono::SecondsFormat::Millis, true),
+            }),
+        );
+        let mut g = lock(inner());
+        g.cycles += 1;
+        g.cycles_with_preempt += u64::from(preempted);
+        g.cycle_commit_sum += delta;
+        g.cycle_commit_max = g.cycle_commit_max.max(delta);
+        g.cycle_hist[(delta as usize).min(CYCLE_HIST - 1)] += 1;
+        g.cycle_ns_max = g.cycle_ns_max.max(ns);
+    }
+}
