+/// The production parent path (CQueryWorkerOwner): call time, the lease time
+/// the parent saw, and the typed outcome.
+#[test]
+#[ignore = "P7 MEASURE: needs NIR1_C_QUERY_WORKER_BIN"]
+fn p7_native() -> Result<()> {
+    use super::super::c_query_worker::{CQueryRetirement, CQueryWorkerOwner};
+    let seeds = p7_list("P7_WSEEDS", "m1,m2,m3,m5,c01");
+    let reps = p7_usize("P7_WREPS", 10);
+    let tag = std::env::var("P7_TAG").unwrap_or_default();
+    let worker_path = PathBuf::from(
+        std::env::var_os("NIR1_C_QUERY_WORKER_BIN")
+            .ok_or_else(|| anyhow::anyhow!("NIR1_C_QUERY_WORKER_BIN missing"))?,
+    );
+    for (scenes, mode) in p7_shapes() {
+        let novel = novel_fixture(scenes, 5, mode)?;
+        let authority = Arc::clone(&novel.fixture.authority);
+        let native_state = WorkspaceState {
+            inner: Mutex::new(Some(ActiveWorkspace::new(Arc::clone(&authority)))),
+            safe_mode: crate::recovery::SafeModeState::default(),
+            switching: WorkspaceLifecycleCompatibilityView::new(false),
+            open_lock: Mutex::new(Default::default()),
+        };
+        let binding = LiveBinding::new(
+            authority.path().to_string_lossy(),
+            format!("test-workspace:{}", authority.identity()),
+            authority.identity(),
+            0,
+        )
+        .with_main_database_file_identity(authority.main_database_file_identity()?);
+        native_state.switching.core().set_ready(binding)?;
+        for seed in &seeds {
+            let mut calls = Vec::new();
+            let mut leases = Vec::new();
+            let mut last = String::new();
+            for _ in 0..reps {
+                let mut owner = CQueryWorkerOwner::new(
+                    active_workspace_snapshot(&native_state)?,
+                    worker_path.clone(),
+                );
+                owner.prepare(PROJECT)?;
+                let started = Instant::now();
+                let result =
+                    owner.query_projected(&request_for(seed, "nir1"), &AtomicBool::new(false));
+                let call = started.elapsed();
+                let _ = owner.retirement() == CQueryRetirement::Retired;
+                if let Some(claim) = authority.claim_c_query_child() {
+                    claim.release();
+                }
+                drop(owner);
+                calls.push(call.as_secs_f64() * 1e3);
+                match result {
+                    Ok(projection) => {
+                        leases.push(projection.elapsed.as_secs_f64() * 1e3);
+                        last = format!(
+                            "available nodes={} edges={}",
+                            projection.graph.nodes.len(),
+                            projection.graph.edges.len()
+                        );
+                    }
+                    Err(error) => last = format!("refused {error:#}"),
+                }
+            }
+            eprintln!(
+                "P7NATIVE tag={tag} scenes={scenes} mode={} seed={seed} last={last} call_ms[{}] lease_ms[{}]",
+                mode.label(),
+                p7_stats(&calls),
+                p7_stats(&leases)
+            );
+        }
+    }
+    Ok(())
+}
