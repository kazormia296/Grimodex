+#[cfg(target_os = "linux")]
+#[test]
+#[ignore = "P7 MEASURE: needs NIR1_C_QUERY_WORKER_BIN"]
+fn p7_product() -> Result<()> {
+    let cases = p7_list("P7_CASES", "p:300000");
+    let tag = std::env::var("P7_TAG").unwrap_or_default();
+    for case in cases {
+        let (kind, size) = case
+            .split_once(':')
+            .ok_or_else(|| anyhow::anyhow!("bad case {case}"))?;
+        let size: usize = size.parse()?;
+        let (fixture, seed, candidate) = match kind {
+            "d" => {
+                let fixture = Fixture::new()?;
+                let candidate = fixture.add_candidate_revision(1, size)?;
+                fixture.republish_graph_index()?;
+                (fixture, "nir1-alice", candidate)
+            }
+            "e" => {
+                let fixture = Fixture::new()?;
+                let candidate = fixture.add_envelope_padded_candidate(1, size)?;
+                fixture.republish_graph_index()?;
+                (fixture, "nir1-alice", candidate)
+            }
+            "p" => {
+                let (fixture, revision) = p7_product_fixture(size)?;
+                (fixture, "v00", revision)
+            }
+            "w" => {
+                // Payload-side padding through the typed writer (the shape that
+                // CR-2 saw fail in registration): `size` is the writer's counted bytes.
+                let fixture = Fixture::new()?;
+                let db = fixture.authority.db();
+                let template = request(db).bundle;
+                let base = writer_input_bytes(&bounded_writer_bundle(&template, 507, 0));
+                let mut payload = request(db);
+                payload.bundle = bounded_writer_bundle(&template, 507, size - base);
+                let created = create_nir1_entity_relation_revision(db, payload)?;
+                approve_typed_revision(db, "nir1-run", &created)?;
+                let candidate = created["revisionId"].as_str().unwrap().to_owned();
+                fixture.republish_graph_index()?;
+                (fixture, "nir1-alice", candidate)
+            }
+            other => anyhow::bail!("unknown case kind {other}"),
+        };
+        let a2 = fixture
+            .a2_admission(&candidate)
+            .map_err(|error| error.to_string());
+        let lengths: (i64, i64, i64) = fixture.authority.with_read_transaction(|conn| {
+            Ok(conn.query_row(
+                "SELECT COALESCE(octet_length(payload_json),0),
+                        COALESCE(octet_length(reconciliation_envelope_json),0),
+                        (SELECT COALESCE(SUM(octet_length(decision_json)),0)
+                           FROM narrative_proposal_decisions d WHERE d.revision_id=r.id)
+                   FROM narrative_proposal_revisions r WHERE r.id=?1",
+                [&candidate],
+                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+            )?)
+        })?;
+        let outcome = p7_spawn_worker(&fixture._directory.0, seed)?;
+        eprintln!(
+            "P7PROD tag={tag} case={case} a2={a2:?} payload_envelope_decision={lengths:?} {outcome}"
+        );
+    }
+    Ok(())
+}
