+            for _ in 0..reps {
+                fixture.authority.db().with_conn(|conn| {
+                    conn.execute_batch("PRAGMA query_only=OFF")?;
+                    Ok(())
+                })?;
+                let registration = Instant::now();
+                let mut reader = fixture.worker_reader()?;
+                reg_ms.push(registration.elapsed().as_secs_f64() * 1e3);
+                LAST_QUERY_ROWS.take();
+                LAST_QUERY_USAGE.take();
+                LAST_QUERY_SQL_STEPS.take();
+                let started = Instant::now();
+                let response = reader.query_for_worker_with_maintenance_deadline(
+                    &request_for(seed, "nir1"),
+                    DEADLINE,
+                )?;
+                query_ms.push(started.elapsed().as_secs_f64() * 1e3);
+                let rows = LAST_QUERY_ROWS.take();
+                let usage = LAST_QUERY_USAGE.take();
+                let steps = LAST_QUERY_SQL_STEPS.take();
+                let (nodes, edges, bindings) = response.graph.as_ref().map_or((0, 0, 0), |graph| {
+                    (
+                        graph.nodes.len(),
+                        graph.edges.len(),
+                        graph.nodes.iter().map(|n| n.bindings.len()).sum::<usize>(),
+                    )
+                });
+                last_usage = usage;
+                last = Some((
+                    response.status.to_owned(),
+                    response.reason.clone(),
+                    rows,
+                    steps,
+                    nodes,
+                    edges,
+                    bindings,
+                ));
+            }
+            let (status, reason, rows, steps, nodes, edges, bindings) = last.unwrap();
+            let (open_status, open_reason, open_steps) = uncapped_steps(&fixture, seed)?;
+            eprintln!(
+                "P7ROW scenes={scenes} mode={} seed={seed} revisions={} eligible={} candidate_rows={} a2_rows={} shared_rows={} a3_rows={} records={} replay_steps={} entities={} edges={} a2_bytes={} a3_bytes={} shared_bytes={} max_revision_bytes={} max_payload_bytes={} unavailable={:?} | production={status}/{reason:?} charged_rows={rows:?} usage(rows,bytes,pages,retained,peak)={last_usage:?} charged_steps={steps:?} nodes={nodes} out_edges={edges} bindings={bindings} | uncapped_steps={open_steps}/{open_status}/{open_reason:?} | query_ms[{}] reg_ms[{}]",
+                mode.label(),
+                replayed.revisions,
+                replayed.eligible,
+                replayed.candidate_rows,
+                replayed.a2_rows,
+                replayed.shared_rows,
+                replayed.a3_rows,
+                replayed.records(),
+                replayed.steps,
+                replayed.entities,
+                replayed.edges,
+                replayed.a2_bytes,
+                replayed.a3_bytes,
+                replayed.shared_bytes,
+                replayed.max_revision_bytes,
+                replayed.max_payload_bytes,
+                replayed.unavailable,
+                p7_stats(&query_ms),
+                p7_stats(&reg_ms),
+            );
+        }
+    }
+    Ok(())
+}
