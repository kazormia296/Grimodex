+/// Spawn the real worker binary directly (one process per query), with the Q
+/// accounting trace on. Returns one line of key=value pairs.
+#[cfg(target_os = "linux")]
+fn p7_spawn_worker(directory: &std::path::Path, seed: &str) -> Result<String> {
+    use std::io::{Read as _, Write as _};
+    use std::process::{Command, Stdio};
+    let worker = PathBuf::from(
+        std::env::var_os("NIR1_C_QUERY_WORKER_BIN")
+            .ok_or_else(|| anyhow::anyhow!("NIR1_C_QUERY_WORKER_BIN missing"))?,
+    );
+    let started = Instant::now();
+    let mut child = Command::new(&worker)
+        .arg(directory)
+        .arg(PROJECT)
+        .env("VERIFY_Q_TRACE", "1")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+    let mut stdout = child.stdout.take().unwrap();
+    let mut stdin = child.stdin.take().unwrap();
+    let mut ready = [0u8; 1];
+    let read = stdout.read(&mut ready).unwrap_or(0);
+    let ready_ok = read == 1 && ready[0] == b'R';
+    let ready_ms = started.elapsed().as_secs_f64() * 1e3;
+    let query_started = Instant::now();
+    if ready_ok {
+        let mut body = Vec::new();
+        for field in [PROJECT, "nir1", seed] {
+            body.extend_from_slice(&(field.len() as u16).to_le_bytes());
+            body.extend_from_slice(field.as_bytes());
+        }
+        let mut message = (body.len() as u16).to_le_bytes().to_vec();
+        message.extend_from_slice(&body);
+        let _ = stdin.write_all(&message);
+    }
+    drop(stdin);
+    let mut frame = Vec::new();
+    let _ = stdout.read_to_end(&mut frame);
+    let status = child.wait()?;
+    let query_ms = query_started.elapsed().as_secs_f64() * 1e3;
+    let mut stderr = String::new();
+    let _ = child.stderr.take().unwrap().read_to_string(&mut stderr);
+    Ok(format!(
+        "ready={ready_ok} ready_ms={ready_ms:.1} query_ms={query_ms:.1} frame_bytes={} exit={:?} stderr=[{}]",
+        frame.len(),
+        status.code(),
+        stderr.trim_end().replace('\n', " | ")
+    ))
+}
