+fn p7_revision_sizes(scenes: usize, mode: ReviewMode, fixture: &Fixture) -> Result<()> {
+    let rows: Vec<(String, i64, i64, i64)> = fixture.authority.with_read_transaction(|conn| {
+        let mut statement = conn.prepare(
+            "SELECT r.id, COALESCE(octet_length(r.payload_json),0),
+                    COALESCE(octet_length(r.reconciliation_envelope_json),0),
+                    (SELECT COALESCE(SUM(octet_length(d.decision_json)),0)
+                       FROM narrative_proposal_decisions d WHERE d.revision_id=r.id)
+               FROM narrative_proposal_revisions r ORDER BY r.rowid",
+        )?;
+        let rows = statement
+            .query_map([], |row| {
+                Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?))
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        Ok(rows)
+    })?;
+    for (id, payload, envelope, decision) in rows {
+        let admission = fixture.authority.with_conn(|conn| {
+            Ok(super::super::input::preflight_revision(
+                conn,
+                PROJECT,
+                &id,
+                usize::MAX / 4,
+                usize::MAX / 4,
+            )?
+            .map(|a| (a.rows, a.bytes, a.payload_bytes)))
+        })?;
+        eprintln!(
+            "P7REV scenes={scenes} mode={} revision={id} payload={payload} envelope={envelope} decision={decision} a2={admission:?}",
+            mode.label()
+        );
+    }
+    Ok(())
+}
