+fn p7_stats(times: &[f64]) -> String {
+    let mut sorted = times.to_vec();
+    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    if sorted.is_empty() {
+        return "n=0".to_owned();
+    }
+    format!(
+        "n={} min={:.2} p50={:.2} max={:.2}",
+        sorted.len(),
+        sorted[0],
+        sorted[sorted.len() / 2],
+        sorted[sorted.len() - 1]
+    )
+}
