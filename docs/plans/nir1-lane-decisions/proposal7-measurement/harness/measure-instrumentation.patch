+
+fn p7_summary(base: &str) -> String {
+    match std::env::var("P7_SUMMARY_CHARS")
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+    {
+        Some(chars) if chars > base.chars().count() => {
+            let filler = "彼女は静かに窓の外を見つめ、過去の約束と未来への不安を胸に抱きながら、物語の行方を思い描いていた。";
+            let mut text = base.to_owned();
+            while text.chars().count() < chars {
+                text.push_str(filler);
+            }
+            text.chars().take(chars).collect()
+        }
+        _ => base.to_owned(),
+    }
+}
+
+fn p7_shapes() -> Vec<(usize, ReviewMode)> {
+    std::env::var("P7_SHAPES")
+        .unwrap_or_else(|_| "10:scene,20:scene,30:scene,50:scene,80:scene".to_owned())
+        .split(',')
+        .filter_map(|part| {
+            let (scenes, mode) = part.split_once(':')?;
+            let mode = match mode {
+                "scene" => ReviewMode::Scene,
+                "fixed" => ReviewMode::Fixed,
+                _ => return None,
+            };
+            Some((scenes.parse().ok()?, mode))
+        })
+        .collect()
+}
+
+fn p7_list(name: &str, default: &str) -> Vec<String> {
+    std::env::var(name)
+        .unwrap_or_else(|_| default.to_owned())
+        .split(',')
+        .filter(|item| !item.is_empty())
+        .map(str::to_owned)
+        .collect()
+}
+
+fn p7_usize(name: &str, default: usize) -> usize {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(default)
+}
