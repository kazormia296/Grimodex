+      # updater 署名の公開鍵がプレースホルダのままだと、配信後に全更新の署名
+      # 検証が必ず失敗する (実機で気づけない)。v1.0.0 以降のビルドで差し替え忘れを
+      # ここで落とす。
+      - name: updater pubkey が本番用に差し替え済みか検証 (v1.0.0 以降)
+        shell: bash
+        run: |
+          VERSION=$(node -p "require('./src-tauri/tauri.conf.json').version")
+          MAJOR="${VERSION%%.*}"
+          PUBKEY=$(node -p "require('./src-tauri/tauri.conf.json').plugins?.updater?.pubkey || ''")
+          if [ "$MAJOR" -ge 1 ] && { [ -z "$PUBKEY" ] || [ "$PUBKEY" = "__REPLACE_WITH_UPDATER_PUBKEY__" ]; }; then
+            echo "::error::updater pubkey がプレースホルダのままです。pnpm tauri signer generate で生成した公開鍵に差し替えてください。" >&2
