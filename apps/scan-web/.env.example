# Public web configuration. Do not put the server-side Full Scan secret here.
VITE_SCAN_API_BASE_URL=https://scan.example
VITE_SCAN_TURNSTILE_REQUIRED=true
VITE_SCAN_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Full Scan entitlement is supplied at runtime by the authenticated host via
# ScanWebApp({ fullAccessToken }), not through a VITE_ build variable.
