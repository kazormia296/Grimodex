{
  "name": "@grimodex/scan-contract",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.js",
      "import": "./dist/schema.js"
    },
    "./web-editor-handoff": {
      "types": "./dist/webEditorWorkspaceHandoff.d.ts",
      "import": "./dist/webEditorWorkspaceHandoff.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:validator": "tsx scripts/generateScanBundleV1Validator.ts",
    "check:validator": "tsx scripts/generateScanBundleV1Validator.ts --check",
    "build": "tsx scripts/generateScanBundleV1Validator.ts --check && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsx scripts/generateScanBundleV1Validator.ts --check && tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
