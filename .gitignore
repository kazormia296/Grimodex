node_modules/
.pnpm-store/
dist/
.env
*.local
.claude/settings.local.json
docs/.claude/settings.local.json
.claude/scheduled_tasks.lock
.obsidian/
.claude/worktrees/
temp/
.cache/
.codex/
.cursor/

# Lindera UniDic 辞書のキャッシュ（~140MB）。
# cargo build 時に LINDERA_DICTIONARIES_PATH でここを指す想定。
# 詳細は src-tauri/crates/grimodex-lint/README を参照。
lindera-cache/

# ruri-v3 ONNX モデル本体 (~150MB fp32 + ~40MB int8)。
# scripts/export-ruri-onnx.py で cl-nagoya 本家から再生成可能。
# Tauri ビルド時にリソースとして同梱するが、git には載せない。
# tokenizer.json / config.json 等の軽量設定ファイルは別途 git に入れて良い。
src-tauri/resources/semantic/**/*.onnx

# GitHub Wiki (Grimodex.wiki.git) を作業ツリー内にクローンしたもの。
# 別リポジトリなのでメインリポジトリでは追跡しない。
grimodex-wiki/

# pnpm screenshot で再生成されるスクリーンショット。
# 再生成コマンドは docs/screenshots/generated/memo.txt 参照（こちらは追跡する）。
docs/screenshots/generated/*.png

# Vitest browser-mode attachments (per-run failure screenshots)
.vitest-attachments/
**/__screenshots__/

# related-scenes ライブ eval の実埋め込み生成物(scripts/relatedScenesLiveEmbed.mjs で再生成)。
# 生成すると relatedScenesLive.eval.test.ts が実行され、無ければ skip。
src/features/related-scenes/liveEval/embeddings.generated.json

# Python venvs for the embedding scripts (calibrate / export / golden).
# scripts/setup-en-embedding.sh / calibrate-embedding-threshold.py 用。
.venv*/

# scripts/seed-sample-*.py が生成する開発/QA 用サンプルワークスペース。
samples/

# chat episodic-recall calibration (生成物・gitignore)
src/features/chat/calibration/embeddings.generated.json

# SDD scratch ledger
.superpowers/
.worktrees/

# Electron シェル（Phase 2）: esbuild 出力 / napi クレートのビルド生成物
dist-electron/
release/electron/
electron/native/**/target/
*.node
