node_modules/
.pnpm-store/
dist/
.env
*.local
.claude/settings.local.json
docs/.claude/settings.local.json
.claude/scheduled_tasks.lock
.obsidian/
.claude/worktrees/
temp/
.cache/
.codex/

# Lindera UniDic 辞書のキャッシュ（~140MB）。
# cargo build 時に LINDERA_DICTIONARIES_PATH でここを指す想定。
# 詳細は src-tauri/crates/grimodex-lint/README を参照。
lindera-cache/

# ruri-v3 ONNX モデル本体 (~150MB fp32 + ~40MB int8)。
# scripts/export-ruri-onnx.py で cl-nagoya 本家から再生成可能。
# Tauri ビルド時にリソースとして同梱するが、git には載せない。
# tokenizer.json / config.json 等の軽量設定ファイルは別途 git に入れて良い。
src-tauri/resources/semantic/**/*.onnx

# GitHub Wiki (Grimodex.wiki.git) を作業ツリー内にクローンしたもの。
# 別リポジトリなのでメインリポジトリでは追跡しない。
grimodex-wiki/

# pnpm screenshot で再生成されるスクリーンショット。
# 再生成コマンドは docs/screenshots/generated/memo.txt 参照（こちらは追跡する）。
docs/screenshots/generated/*.png

# Vitest browser-mode attachments (per-run failure screenshots)
.vitest-attachments/
**/__screenshots__/
