{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-dependency-producer-registry-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "registryVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "narrative-dependency-producer-generation-registry"
    },
    "registryVersion": {
      "const": "narrative-producer-generation/v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "writer",
        "generation",
        "consumerKind",
        "declaration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "writer": {
          "type": "object",
          "required": ["module", "symbol"],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "declarationSetGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "consumerKind": {
          "type": "string",
          "minLength": 1
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "id": { "const": "proposal-revision-source-basis" }
            },
            "required": ["id"]
          },
          "then": {
            "required": ["declarationSetGeneration"],
            "properties": {
              "declarationSetGeneration": { "const": 1 }
            }
          },
          "else": {
            "not": { "required": ["declarationSetGeneration"] }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
