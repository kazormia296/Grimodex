{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-ir-contract-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "adr",
    "contractVersion",
    "identity",
    "authorities",
    "vocabularies",
    "v1ProducerMapping",
    "envelope",
    "monotonicity",
    "chroniclePilot",
    "humanDerived",
    "materialBasis",
    "staleValidation",
    "crossRuntimeAdapter",
    "consumerBinding",
    "activation",
    "scopeAdoption",
    "fixtures",
    "nonGoals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "narrative-ir-contract"
    },
    "adr": {
      "const": "docs/adr/011-narrative-ir-revision-semantics-contract.md"
    },
    "contractVersion": {
      "const": "narrative-ir/2"
    },
    "identity": {
      "type": "object",
      "required": [
        "revisionTable",
        "revisionIdColumn",
        "consumerKind",
        "projectScoped",
        "durability",
        "portableReference",
        "portableExport",
        "independentRevisionConsumer",
        "independentRevisionConsumerStatus",
        "heuristicIdentity"
      ],
      "properties": {
        "revisionTable": {
          "const": "narrative_proposal_revisions"
        },
        "revisionIdColumn": {
          "const": "id"
        },
        "consumerKind": {
          "const": "proposal-revision"
        },
        "projectScoped": {
          "const": true
        },
        "durability": {
          "const": "while-project-exists"
        },
        "portableReference": {
          "const": [
            "projectId",
            "revisionId",
            "envelopeDigest",
            "contractVersion"
          ]
        },
        "portableExport": {
          "type": "object",
          "required": [
            "requiredClosure",
            "originalProjectAvailability"
          ],
          "properties": {
            "requiredClosure": {
              "const": "referenced-closure"
            },
            "originalProjectAvailability": {
              "const": "must-not-be-assumed"
            }
          },
          "additionalProperties": false
        },
        "independentRevisionConsumer": {
          "const": "narrative-ir-revision"
        },
        "independentRevisionConsumerStatus": {
          "const": "not-yet-modelled"
        },
        "heuristicIdentity": {
          "const": "forbid"
        }
      },
      "additionalProperties": false
    },
    "authorities": {
      "type": "object",
      "required": [
        "immutableRevision",
        "review",
        "freshness",
        "projectionExecution",
        "applicationContribution",
        "semanticIndex"
      ],
      "additionalProperties": false,
      "properties": {
        "immutableRevision": {
          "const": "proposal-revision+narrative-revision-envelope"
        },
        "review": {
          "const": "decision-ledger"
        },
        "freshness": {
          "const": "narrative_consumer_freshness"
        },
        "projectionExecution": {
          "const": "prepared-commit+typed-writer"
        },
        "applicationContribution": {
          "const": "application-contribution-ledger"
        },
        "semanticIndex": {
          "const": "rebuildable-acceleration-only"
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "required": [
        "assertionKinds",
        "assertionModalities",
        "assertionPolarities",
        "producerKinds",
        "supportClasses",
        "changeKinds",
        "contextExposures"
      ],
      "properties": {
        "assertionKinds": {
          "const": [
            "scene-event@1"
          ]
        },
        "assertionModalities": {
          "const": [
            "modality-explicit-text",
            "modality-narrator-claim",
            "modality-hearsay",
            "modality-character-belief",
            "modality-inference",
            "modality-hypothesis",
            "modality-author-declaration",
            "modality-imported-assertion"
          ]
        },
        "assertionPolarities": {
          "const": [
            "affirmative",
            "negative",
            "uncertain"
          ]
        },
        "producerKinds": {
          "const": [
            "ai-inference",
            "reconciler-proposal",
            "author-declaration",
            "import-metadata",
            "legacy-migration"
          ]
        },
        "supportClasses": {
          "const": [
            "author-declared",
            "direct-source",
            "reported-source",
            "single-source-inference",
            "multi-source-inference",
            "imported-assertion",
            "unresolved"
          ]
        },
        "changeKinds": {
          "const": [
            "add",
            "revise",
            "retract",
            "merge",
            "split"
          ]
        },
        "contextExposures": {
          "const": [
            "deterministic-stage",
            "author-supplied",
            "model-visible"
          ]
        }
      },
      "additionalProperties": false
    },
    "v1ProducerMapping": {
      "type": "object",
      "required": [
        "producerKind",
        "producerIdSource",
        "producerVersionSource"
      ],
      "properties": {
        "producerKind": {
          "const": "reconciler-proposal"
        },
        "producerIdSource": {
          "const": "reconcilerId"
        },
        "producerVersionSource": {
          "const": "reconcilerVersion"
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": [
        "schemaVersion",
        "requiredFields",
        "assertionDigestDomains",
        "changeIntent",
        "projectionBinding",
        "producerActorSeparation",
        "reviewFreshnessProjectionOutsideRevision"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "requiredFields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertionDigestDomains": {
          "type": "object",
          "required": [
            "assertionCoreDigest",
            "scopeDigest",
            "assertionDigest",
            "disclosureFieldsExcludedFromAssertionCore"
          ],
          "additionalProperties": false,
          "properties": {
            "assertionCoreDigest": {
              "const": [
                "assertionKind",
                "payloadSchemaRef",
                "typedSemanticPayload",
                "modality",
                "polarity",
                "supportClass",
                "producer",
                "producerConfidence"
              ]
            },
            "scopeDigest": {
              "const": [
                "canonicalNarrativeScopeV2"
              ]
            },
            "assertionDigest": {
              "const": [
                "assertionCoreDigest",
                "scopeDigest"
              ]
            },
            "disclosureFieldsExcludedFromAssertionCore": {
              "const": [
                "secret",
                "revealDocumentRef"
              ]
            }
          }
        },
        "changeIntent": {
          "type": "object",
          "required": [
            "addTargetProjectionRef",
            "retractTargetProjectionRef",
            "humanDerivedMustPreserve"
          ],
          "additionalProperties": false,
          "properties": {
            "addTargetProjectionRef": {
              "const": "forbidden"
            },
            "retractTargetProjectionRef": {
              "const": "required"
            },
            "humanDerivedMustPreserve": {
              "const": "exact"
            }
          }
        },
        "projectionBinding": {
          "type": "object",
          "required": [
            "proposalKindAndSchemaDistinct",
            "recomputePayloadDigestInNative",
            "adapterContractRequired"
          ],
          "additionalProperties": false,
          "properties": {
            "proposalKindAndSchemaDistinct": {
              "const": true
            },
            "recomputePayloadDigestInNative": {
              "const": true
            },
            "adapterContractRequired": {
              "const": true
            }
          }
        },
        "producerActorSeparation": {
          "const": true
        },
        "reviewFreshnessProjectionOutsideRevision": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "monotonicity": {
      "type": "object",
      "required": [
        "currentRevisionRule",
        "forbiddenTransitions",
        "semanticAuthority",
        "typedWriterValidation",
        "structuralDefense",
        "contractFreezeOnly"
      ],
      "properties": {
        "currentRevisionRule": {
          "const": "once-v2-always-v2"
        },
        "forbiddenTransitions": {
          "const": [
            "v2-to-v1",
            "v2-to-no-envelope",
            "v2-to-legacy-unbound",
            "v2-to-legacy-inherit-reconciliation-envelope"
          ]
        },
        "semanticAuthority": {
          "const": "typed-writer"
        },
        "typedWriterValidation": {
          "const": [
            "parent-current-revision-cas",
            "v2-lineage-monotonicity",
            "adapter-version",
            "digest-recomputation",
            "derivation-invariants",
            "material-basis",
            "change-intent",
            "proposal-binding"
          ]
        },
        "structuralDefense": {
          "type": "object",
          "required": [
            "kind",
            "role",
            "state",
            "productionEntryPoints",
            "errorCode"
          ],
          "properties": {
            "kind": {
              "const": "sqlite-before-insert-trigger"
            },
            "role": {
              "const": "structural-defense-only"
            },
            "state": {
              "const": "deferred-until-after-c2-zb"
            },
            "productionEntryPoints": {
              "const": []
            },
            "errorCode": {
              "const": "NEX_REVISION_ENVELOPE_DOWNGRADE_FORBIDDEN"
            }
          },
          "additionalProperties": false
        },
        "contractFreezeOnly": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "chroniclePilot": {
      "type": "object",
      "required": [
        "assertionKind",
        "productWiredChangeKinds",
        "declaredOrReservedChangeKinds",
        "existingProjectionRevisionStatus"
      ],
      "properties": {
        "assertionKind": {
          "const": "scene-event@1"
        },
        "productWiredChangeKinds": {
          "const": [
            "add"
          ]
        },
        "declaredOrReservedChangeKinds": {
          "const": [
            "revise",
            "retract",
            "merge",
            "split"
          ]
        },
        "existingProjectionRevisionStatus": {
          "const": "requires-separately-ratified-proposal-kind-and-apply-path"
        }
      },
      "additionalProperties": false
    },
    "humanDerived": {
      "type": "object",
      "required": [
        "requestFields",
        "clientSubmittedFields",
        "nativeOwnedFields",
        "persistedBasis",
        "contextExposureAllowed",
        "contextExposureForbidden",
        "classification",
        "invariants"
      ],
      "properties": {
        "requestFields": {
          "const": [
            "proposalId",
            "expectedCurrentRevisionId",
            "parentRevisionId",
            "expectedParentEnvelopeDigest",
            "proposalPayload",
            "adapter",
            "surfaceId"
          ]
        },
        "clientSubmittedFields": {
          "const": [
            "proposalId",
            "expectedCurrentRevisionId",
            "parentRevisionId",
            "expectedParentEnvelopeDigest",
            "proposalPayload",
            "adapter",
            "surfaceId"
          ]
        },
        "nativeOwnedFields": {
          "const": [
            "parentLookupAndCas",
            "proposalPayloadDiff",
            "pathClassification",
            "strongestDerivationClassification",
            "childAssertionAndScope",
            "effectiveMaterialBasis",
            "digestComputation",
            "dependencyDeclaration",
            "currentEpochFreshness",
            "finalPersistence"
          ]
        },
        "persistedBasis": {
          "const": [
            "parentRevisionId",
            "expectedParentEnvelopeDigest",
            "parentAssertionDigest",
            "rootInterpretationRevisionId",
            "derivation",
            "revisionActor",
            "derivationContextSet",
            "derivationContextSetDigest"
          ]
        },
        "contextExposureAllowed": {
          "const": [
            "deterministic-stage",
            "author-supplied"
          ]
        },
        "contextExposureForbidden": {
          "const": [
            "model-visible"
          ]
        },
        "classification": {
          "type": "object",
          "required": [
            "pathClasses",
            "precedence",
            "cumulativeAllowedPathClasses",
            "unknownPathPolicy",
            "clientMetadataAuthority",
            "assertionOverrideStatus",
            "fixtures"
          ],
          "additionalProperties": false,
          "properties": {
            "pathClasses": {
              "type": "object",
              "required": [
                "projectionOnly",
                "scopeAffecting",
                "assertionAffecting"
              ],
              "properties": {
                "projectionOnly": {
                  "const": [
                    "/title",
                    "/note"
                  ]
                },
                "scopeAffecting": {
                  "const": [
                    "/disclosure/secret",
                    "/disclosure/revealDocumentRef"
                  ]
                },
                "assertionAffecting": {
                  "const": []
                }
              },
              "additionalProperties": false
            },
            "precedence": {
              "const": [
                "assertion-override",
                "scope-override",
                "projection-only"
              ]
            },
            "cumulativeAllowedPathClasses": {
              "type": "object",
              "required": [
                "projectionOnly",
                "scopeOverride",
                "assertionOverride"
              ],
              "properties": {
                "projectionOnly": {
                  "const": [
                    "projection-only"
                  ]
                },
                "scopeOverride": {
                  "const": [
                    "projection-only",
                    "scope-affecting"
                  ]
                },
                "assertionOverride": {
                  "const": []
                }
              },
              "additionalProperties": false
            },
            "unknownPathPolicy": {
              "const": "reject"
            },
            "clientMetadataAuthority": {
              "const": "forbid"
            },
            "assertionOverrideStatus": {
              "const": "reserved-rejected"
            },
            "fixtures": {
              "type": "array",
              "minItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "changedPaths",
                  "expectedDisposition"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "changedPaths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^/"
                    }
                  },
                  "expectedDerivationKind": {
                    "enum": [
                      "projection-only",
                      "scope-override",
                      "assertion-override"
                    ]
                  },
                  "changedPathClasses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "projection-only",
                        "scope-affecting",
                        "assertion-affecting"
                      ]
                    }
                  },
                  "expectedDisposition": {
                    "enum": [
                      "accept",
                      "reject"
                    ]
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "expectedDisposition": {
                          "const": "accept"
                        }
                      },
                      "required": [
                        "expectedDisposition"
                      ]
                    },
                    "then": {
                      "required": [
                        "expectedDerivationKind",
                        "changedPathClasses"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "invariants": {
          "type": "object",
          "required": [
            "projectionOnly",
            "scopeOverride",
            "clientCannotSupply"
          ],
          "additionalProperties": false,
          "properties": {
            "projectionOnly": {
              "const": [
                "assertionCoreDigest-preserved",
                "scopeDigest-preserved",
                "assertionDigest-preserved",
                "all-paths-projection-only"
              ]
            },
            "scopeOverride": {
              "const": [
                "assertionCoreDigest-preserved",
                "scope-deterministically-rederived",
                "scopeDigest-may-change",
                "all-paths-projection-or-scope"
              ]
            },
            "clientCannotSupply": {
              "const": [
                "derivationKind",
                "changedPaths",
                "scope",
                "childAssertion",
                "childDigests"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "materialBasis": {
      "type": "object",
      "required": [
        "humanDerivedOwnsDeclarations",
        "declarations",
        "projectionOnlyInheritance",
        "scopeOverridePolicy",
        "noLineageFreshnessAuthority",
        "zeroEdgeCurrentRevision",
        "currentEpochEvaluation"
      ],
      "additionalProperties": false,
      "properties": {
        "humanDerivedOwnsDeclarations": {
          "const": true
        },
        "declarations": {
          "const": [
            "sourceBasis",
            "evidenceSet",
            "dependencySet",
            "v1CompatibilityEdges",
            "v2SealedDeclarationSet",
            "edgeStates",
            "consumerFreshness"
          ]
        },
        "projectionOnlyInheritance": {
          "const": "source-evidence-dependency-sets-identical"
        },
        "scopeOverridePolicy": {
          "const": "inherit-applicable-and-rederive-scope-resolution"
        },
        "noLineageFreshnessAuthority": {
          "const": true
        },
        "zeroEdgeCurrentRevision": {
          "const": "forbidden"
        },
        "currentEpochEvaluation": {
          "const": "atomic-before-current-revision-promotion"
        }
      }
    },
    "staleValidation": {
      "type": "object",
      "required": [
        "interpretation",
        "humanDerived",
        "fixtures"
      ],
      "properties": {
        "interpretation": {
          "type": "object",
          "required": [
            "requireLiveSourceTokenEquality",
            "staleRefusal"
          ],
          "additionalProperties": false,
          "properties": {
            "requireLiveSourceTokenEquality": {
              "const": true
            },
            "staleRefusal": {
              "const": "NEX_READ_SET_STALE"
            }
          }
        },
        "humanDerived": {
          "type": "object",
          "required": [
            "requireLiveSourceTokenEquality",
            "preserveObservedTokens",
            "internalIntegrity",
            "evaluateAgainstCurrentLiveSource",
            "publishStates",
            "doesNotBypassApplyOCC",
            "doesNotClearBuildActions",
            "doesNotPerformSemanticRetraction"
          ],
          "additionalProperties": false,
          "properties": {
            "requireLiveSourceTokenEquality": {
              "const": false
            },
            "preserveObservedTokens": {
              "const": true
            },
            "internalIntegrity": {
              "const": [
                "quote-quoteDigest",
                "source-basis-consistency",
                "evidence-consistency",
                "dependency-consistency"
              ]
            },
            "evaluateAgainstCurrentLiveSource": {
              "const": true
            },
            "publishStates": {
              "const": [
                "fresh",
                "stale",
                "source-missing",
                "anchor-mismatch",
                "read-set-drift",
                "unknown"
              ]
            },
            "doesNotBypassApplyOCC": {
              "const": true
            },
            "doesNotClearBuildActions": {
              "const": true
            },
            "doesNotPerformSemanticRetraction": {
              "const": true
            }
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "basis",
              "expected"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "interpretation-live-token-mismatch-refuses",
                  "human-derived-stale-parent-publishes-state"
                ]
              },
              "basis": {
                "enum": [
                  "interpretation",
                  "human-derived"
                ]
              },
              "expected": {
                "enum": [
                  "reject-live-token",
                  "accept-and-publish-current-state"
                ]
              }
            },
            "oneOf": [
              {
                "const": {
                  "id": "interpretation-live-token-mismatch-refuses",
                  "basis": "interpretation",
                  "expected": "reject-live-token"
                }
              },
              {
                "const": {
                  "id": "human-derived-stale-parent-publishes-state",
                  "basis": "human-derived",
                  "expected": "accept-and-publish-current-state"
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "crossRuntimeAdapter": {
      "type": "object",
      "required": [
        "id",
        "version",
        "assertionKind",
        "initialScopeDerivationRuntime",
        "humanDerivedScopeRuntime",
        "canonicalOutput",
        "goldenFixtureRequired",
        "fixtureFile",
        "requiredCaseIds",
        "noIndependentRuntimeInterpretation"
      ],
      "properties": {
        "id": {
          "const": "chronicle.scene-event"
        },
        "version": {
          "const": "1"
        },
        "assertionKind": {
          "const": "scene-event@1"
        },
        "initialScopeDerivationRuntime": {
          "const": "typescript"
        },
        "humanDerivedScopeRuntime": {
          "const": "rust"
        },
        "canonicalOutput": {
          "const": "byte-identical-canonical-scope-json-and-scope-digest"
        },
        "goldenFixtureRequired": {
          "const": true
        },
        "fixtureFile": {
          "const": "policies/narrative/fixtures/narrative-ir/chronicle-scene-event-v2.json"
        },
        "requiredCaseIds": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "noIndependentRuntimeInterpretation": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "consumerBinding": {
      "type": "object",
      "required": [
        "consumerKind",
        "childHumanDerivedRevisionIsFirstClassConsumer",
        "childOwnsSourceEvidenceDependencyAndFreshness",
        "freshnessLookup",
        "hiddenRootLineageLookup"
      ],
      "properties": {
        "consumerKind": {
          "const": "proposal-revision"
        },
        "childHumanDerivedRevisionIsFirstClassConsumer": {
          "const": true
        },
        "childOwnsSourceEvidenceDependencyAndFreshness": {
          "const": true
        },
        "freshnessLookup": {
          "const": "child-consumer-identity"
        },
        "hiddenRootLineageLookup": {
          "const": "forbid"
        }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": [
        "state",
        "productionEntryPoints",
        "scanRoots",
        "productionMarkers",
        "prerequisites",
        "v2Emission",
        "humanDerivedV2Ui",
        "currentRevisionPromotion",
        "pureFixtureGeneration",
        "productionFallback"
      ],
      "properties": {
        "state": {
          "const": "disabled"
        },
        "productionEntryPoints": {
          "const": []
        },
        "scanRoots": {
          "const": [
            "src",
            "electron",
            "src-tauri"
          ]
        },
        "productionMarkers": {
          "const": [
            "NARRATIVE_IR_V2_PRODUCTION_ENABLED",
            "createHumanDerivedNarrativeRevisionV2",
            "CHRONICLE_SCENE_EVENT_V2_PRODUCTION"
          ]
        },
        "prerequisites": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "v2Emission": {
          "const": "blocked-until-c2b"
        },
        "humanDerivedV2Ui": {
          "const": "blocked-until-c2b"
        },
        "currentRevisionPromotion": {
          "const": "blocked-until-c2b"
        },
        "pureFixtureGeneration": {
          "const": "allowed-before-activation"
        },
        "productionFallback": {
          "const": "existing-v1-path"
        }
      },
      "additionalProperties": false
    },
    "scopeAdoption": {
      "type": "object",
      "required": [
        "owner",
        "independentFrom",
        "lifecycleStates",
