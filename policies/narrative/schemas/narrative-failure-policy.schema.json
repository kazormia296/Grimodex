{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-failure-policy-v1.json",
  "type": "object",
  "required": ["schemaVersion", "contract", "failureCodePrefix", "retryDispositions", "nextAttemptInvariant", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "narrative-failure-policy" },
    "failureCodePrefix": { "const": "NEX_" },
    "retryDispositions": {
      "type": "array",
      "items": { "enum": ["retryable", "terminal", "superseded", "manual"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "nextAttemptInvariant": { "type": "string", "minLength": 1 },
    "findingRoutingMatrix": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["failureCode", "findingRoute"],
        "properties": {
          "failureCode": {
            "type": "string",
            "pattern": "^NEX_[A-Z0-9_]+$"
          },
          "findingRoute": {
            "enum": ["none", "maintenance-inbox"]
          }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "failureCode",
          "retryDisposition",
          "maxAttempts",
          "backoffPolicy",
          "nextAttemptPolicy",
          "policyVersion"
        ],
        "properties": {
          "failureCode": { "type": "string", "pattern": "^NEX_[A-Z0-9_]+$" },
          "retryDisposition": { "enum": ["retryable", "terminal", "superseded", "manual"] },
          "maxAttempts": { "type": "integer", "minimum": 0 },
          "backoffPolicy": { "type": "string", "minLength": 1 },
          "nextAttemptPolicy": { "type": "string", "minLength": 1 },
          "policyVersion": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policies": {
            "contains": {
              "properties": {
                "failureCode": {
                  "enum": [
                    "NEX_MAINTENANCE_TRANSIENT",
                    "NEX_DEPENDENCY_BACKFILL_CONTRACT_VIOLATION",
                    "NEX_MAINTENANCE_INTERRUPTED"
                  ]
                }
              },
              "required": ["failureCode"]
            }
          }
        },
        "required": ["policies"]
      },
      "then": { "required": ["findingRoutingMatrix"] }
    }
  ],
  "additionalProperties": false
}
