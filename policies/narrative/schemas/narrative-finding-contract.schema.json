{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-finding-contract-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "reasonCodes",
    "unknownReasonCodePolicy",
    "observationStorageClass",
    "epochBinding",
    "freshnessSnapshotPolicy",
    "currentFreshnessLookup",
    "negativeFixture"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "narrative-finding-contract" },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "unknownReasonCodePolicy": { "const": "fail-closed" },
    "observationStorageClass": { "const": "rebuildable-derived-state" },
    "epochBinding": { "const": "required" },
    "freshnessSnapshotPolicy": { "const": "diagnostic-only" },
    "currentFreshnessLookup": { "const": "narrative-consumer-freshness" },
    "negativeFixture": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
