{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-execution-state-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "entities",
    "runSupersedeCascade",
    "runCancelCascade",
    "crossEntityInvariant"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "narrative-execution-state" },
    "entities": {
      "type": "object",
      "required": ["run", "task", "attempt"],
      "properties": {
        "run": { "$ref": "#/$defs/entityState" },
        "task": { "$ref": "#/$defs/entityState" },
        "attempt": { "$ref": "#/$defs/entityState" }
      },
      "additionalProperties": false
    },
    "runSupersedeCascade": { "$ref": "#/$defs/runCascade" },
    "runCancelCascade": { "$ref": "#/$defs/runCascade" },
    "crossEntityInvariant": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "runCascade": {
      "type": "object",
      "required": ["task", "attempt"],
      "properties": {
        "task": {
          "type": "object",
          "required": ["fromStatuses", "toStatus"],
          "properties": {
            "fromStatuses": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "toStatus": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "attempt": {
          "type": "object",
          "required": [
            "fromStatuses",
            "toStatus",
            "failureCode",
            "retryDisposition"
          ],
          "properties": {
            "fromStatuses": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "toStatus": { "type": "string", "minLength": 1 },
            "failureCode": { "type": "string", "pattern": "^NEX_[A-Z0-9_]+$" },
            "retryDisposition": {
              "enum": ["retryable", "terminal", "superseded", "manual"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entityState": {
      "type": "object",
      "required": ["statuses", "terminalStatuses", "derivedView"],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "terminalStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "derivedView": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "type": "object",
            "required": ["phase", "outcome"],
            "properties": {
              "phase": { "enum": ["queued", "running", "terminal"] },
              "outcome": {
                "anyOf": [
                  { "type": "null" },
                  { "enum": ["succeeded", "failed", "cancelled", "superseded"] }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
