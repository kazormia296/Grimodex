{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/narrative-run-kind-policy-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "principle",
    "runKinds",
    "apiSplit",
    "cutover"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "narrative-run-kind-policy" },
    "principle": { "type": "string", "minLength": 1 },
    "runKinds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "properties": { "runKind": { "const": "dependency-backfill" } },
            "required": ["runKind"]
          }
        },
        {
          "contains": {
            "properties": { "runKind": { "const": "dependency-verify" } },
            "required": ["runKind"]
          }
        },
        {
          "contains": {
            "properties": {
              "runKind": { "const": "dependency-rebuild-derived" }
            },
            "required": ["runKind"]
          }
        },
        {
          "contains": {
            "properties": { "runKind": { "const": "incremental-freshness" } },
            "required": ["runKind"]
          }
        },
        {
          "contains": {
            "properties": { "runKind": { "const": "dependency-repair" } },
            "required": ["runKind"]
          }
        }
      ],
      "items": { "$ref": "#/$defs/runKindPolicy" }
    },
    "apiSplit": {
      "type": "object",
      "required": ["replaces", "reason", "operations"],
      "properties": {
        "replaces": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "cutover": {
      "type": "object",
      "required": [
        "gate",
        "requiredForCanonicalCutover",
        "beforeCutover",
        "afterCutover",
        "editingNeverBlockedByCutoverReadiness",
        "uiDegradationWhenNotReady"
      ],
      "properties": {
        "gate": { "const": "C2-Z" },
        "requiredForCanonicalCutover": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "beforeCutover": {
          "type": "object",
          "required": ["freshnessAuthority", "genericGraphRole"],
          "properties": {
            "freshnessAuthority": { "const": "legacy" },
            "genericGraphRole": { "const": "shadow" }
          },
          "additionalProperties": false
        },
        "afterCutover": {
          "type": "object",
          "required": ["freshnessAuthority"],
          "properties": {
            "freshnessAuthority": { "const": "generic-consumer-freshness" }
          },
          "additionalProperties": false
        },
        "editingNeverBlockedByCutoverReadiness": { "const": true },
        "uiDegradationWhenNotReady": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "runKindPolicy": {
      "type": "object",
      "required": [
        "runKind",
        "existingRunKindColumnValue",
        "purpose",
        "trigger",
        "sameWorkKeyReuse",
        "epochBound",
        "cursorBound",
        "periodic",
        "manualRetry",
        "writes",
        "adminCommands",
        "implementationStatus"
      ],
      "properties": {
        "runKind": {
          "enum": [
            "dependency-backfill",
            "dependency-verify",
            "dependency-rebuild-derived",
            "incremental-freshness",
            "dependency-repair"
          ]
        },
        "existingRunKindColumnValue": {
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "trigger": {
          "enum": [
            "automatic-once-after-schema-upgrade",
            "automatic-on-trigger-event",
            "automatic-when-derived-state-absent-or-invalid",
            "automatic-on-change-feed",
            "manual-only"
          ]
        },
        "triggerDetail": { "type": "string", "minLength": 1 },
        "triggerEvents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "manualTriggerAllowed": { "type": "boolean" },
        "sameWorkKeyReuse": {
          "enum": [
            "reuse-running-and-completed",
            "reuse-running-only",
            "no-automatic-reuse-decision"
          ]
        },
        "sameRequestIdReuse": { "const": "idempotent-replay" },
        "completedRunManualRepeat": { "type": "boolean" },
        "completedRunReuseNote": { "type": "string", "minLength": 1 },
        "skipReRunWhen": { "type": "string", "minLength": 1 },
        "epochBound": { "const": true },
        "cursorBound": { "type": "boolean" },
        "cursorConsumerId": { "type": "string", "minLength": 1 },
        "maxCanonicalSequencesPerBatch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "executionAuthority": {
          "enum": ["serialized-live-workspace-authority"]
        },
        "missingSemanticEpochBehavior": {
          "enum": ["wait-for-canonical-epoch-authority"]
        },
        "retryPolicy": {
          "type": "object",
          "required": [
            "maxAttemptsPerTask",
            "exhaustedFailureCode",
            "exhaustedRetryDisposition",
            "failurePolicyVersion",
            "taskAndRunStatusAfterExhaustion",
            "cursorAfterExhaustion",
            "schedulerAfterExhaustion",
            "newEpochReservationRecovery",
            "exhaustedRunAfterNewEpoch"
          ],
          "properties": {
            "maxAttemptsPerTask": { "type": "integer", "minimum": 1 },
            "exhaustedFailureCode": {
              "type": "string",
              "pattern": "^NEX_[A-Z0-9_]+$"
            },
            "exhaustedRetryDisposition": {
              "enum": ["retryable", "terminal", "superseded", "manual"]
            },
            "failurePolicyVersion": { "type": "string", "minLength": 1 },
            "taskAndRunStatusAfterExhaustion": {
              "type": "string",
              "minLength": 1
            },
            "cursorAfterExhaustion": { "type": "string", "minLength": 1 },
            "schedulerAfterExhaustion": {
              "type": "string",
              "minLength": 1
            },
            "newEpochReservationRecovery": {
              "type": "string",
              "minLength": 1
            },
            "exhaustedRunAfterNewEpoch": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "resumeSemantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "completedWithUnackedRangeInvariant": {
          "type": "string",
          "minLength": 1
        },
        "periodic": { "const": false },
        "manualRetry": {
          "anyOf": [{ "type": "boolean" }, { "type": "string", "minLength": 1 }]
        },
        "manualRetryRole": { "type": "string", "minLength": 1 },
        "manualRetryNote": { "type": "string", "minLength": 1 },
        "writes": {
          "enum": [
            "durable-graph",
            "rebuildable-state-only",
            "diagnostics-only"
          ]
        },
        "writesAllowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidSideEffectRepair": { "type": "boolean" },
        "forbiddenWrites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dualWriteOrdering": { "type": "string", "minLength": 1 },
        "sealedParameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "duringBackfillProductBehavior": {
          "type": "object",
          "required": [
            "editingBlocked",
            "freshnessReadAuthority",
            "genericGraphRole",
            "onFailure"
          ],
          "properties": {
            "editingBlocked": { "const": false },
            "freshnessReadAuthority": { "const": "legacy" },
            "genericGraphRole": { "const": "shadow-building" },
            "onFailure": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "autoRetryableFailureClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "manualOnlyFailureClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "manualOnlyFailureCode": {
          "type": "string",
          "pattern": "^NEX_[A-Z0-9_]+$"
        },
        "verifiesDurableGraph": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verifiesRebuildableState": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rebuildableTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredPreconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedRepairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenRepairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unrecoverableDisposition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adminCommands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationStatus": {
          "type": "object",
          "description": "Whether this Run Kind's declared trigger is actually wired in the shipping runtime. Declared per Run Kind so the contract cannot silently describe a future state as if it were live; validate-run-kind-policy.mjs cross-checks it against the real Rust call graph in both directions.",
          "required": ["state", "productionEntryPoints"],
          "properties": {
            "state": { "enum": ["wired", "unwired-blocked"] },
            "triggerSymbol": {
              "type": "string",
              "minLength": 1,
              "description": "Rust function an automatic trigger must call for this Run Kind to count as wired. Required when trigger is automatic-*."
            },
            "productionEntryPoints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 },
              "description": "How this Run Kind can actually be started today."
            },
            "blockedReason": { "type": "string", "minLength": 1 },
            "blockedOn": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "runKind": { "const": "incremental-freshness" } },
            "required": ["runKind"]
          },
          "then": {
            "required": [
              "cursorConsumerId",
              "maxCanonicalSequencesPerBatch",
              "executionAuthority",
              "missingSemanticEpochBehavior",
              "retryPolicy",
              "resumeSemantics",
              "completedWithUnackedRangeInvariant",
              "writesAllowed",
              "forbiddenWrites"
            ],
            "properties": {
              "sameWorkKeyReuse": { "const": "reuse-running-only" },
              "cursorBound": { "const": true },
              "trigger": { "const": "automatic-on-change-feed" },
              "cursorConsumerId": {
                "const": "narrative-incremental-freshness/v1"
              },
              "maxCanonicalSequencesPerBatch": { "const": 32 },
              "executionAuthority": {
                "const": "serialized-live-workspace-authority"
              },
              "missingSemanticEpochBehavior": {
                "const": "wait-for-canonical-epoch-authority"
              },
              "retryPolicy": {
                "const": {
                  "maxAttemptsPerTask": 3,
                  "exhaustedFailureCode": "NEX_INCREMENTAL_FRESHNESS_RETRY_EXHAUSTED",
                  "exhaustedRetryDisposition": "terminal",
                  "failurePolicyVersion": "v1",
                  "taskAndRunStatusAfterExhaustion": "failed",
                  "cursorAfterExhaustion": "reserved-lease-free",
                  "schedulerAfterExhaustion": "idle-until-new-semantic-epoch",
                  "newEpochReservationRecovery": "release-and-reprocess-under-new-run",
                  "exhaustedRunAfterNewEpoch": "remains-terminal-failed"
                }
              },
              "resumeSemantics": {
                "const": [
                  "reuse-sealed-change-set",
                  "reclaim-expired-cursor-reservation",
                  "resume-running-run-task-attempt"
                ]
              },
              "completedWithUnackedRangeInvariant": {
                "const": "never-reuse-completed-run-and-reprocess-under-new-runtime-owned-run"
              },
              "manualRetry": { "const": false },
              "writes": { "const": "rebuildable-state-only" },
              "writesAllowed": {
                "const": [
                  "run-task-attempt-state",
                  "narrative-change-set",
                  "freshness-evaluator-cursor",
                  "dependency-edge-state",
                  "consumer-freshness",
                  "finding-observation"
                ]
              },
              "forbiddenWrites": {
                "allOf": [
                  { "contains": { "const": "domain-state" } },
                  { "contains": { "const": "attention" } }
                ]
              },
              "adminCommands": { "maxItems": 0 },
              "implementationStatus": {
                "required": ["triggerSymbol", "productionEntryPoints"],
                "properties": {
                  "triggerSymbol": {
                    "const": "run_incremental_freshness_cycle"
                  },
                  "productionEntryPoints": {
                    "const": ["run_narrative_freshness_cycle"]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "cursorBound": { "const": false },
              "adminCommands": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
