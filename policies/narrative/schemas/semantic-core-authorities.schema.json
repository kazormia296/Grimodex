{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/semantic-core-authorities-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "authorities",
    "semanticIndexAllowedFields",
    "semanticIndexReservation",
    "forbiddenFreshnessClaims",
    "secondaryFreshnessAuthorityPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "narrative-semantic-core-authorities"
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concern",
          "canonicalAuthority",
          "compatibilityMirror",
          "writePolicy"
        ],
        "properties": {
          "concern": {
            "type": "string",
            "minLength": 1
          },
          "canonicalAuthority": {
            "type": "string",
            "minLength": 1
          },
          "compatibilityMirror": {
            "type": [
              "string",
              "null"
            ]
          },
          "writePolicy": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "concern": {
              "const": "search-generation"
            }
          },
          "required": [
            "concern"
          ]
        },
        "then": {
          "properties": {
            "canonicalAuthority": {
              "const": "nir1-reviewed-chronicle-v1 producer"
            },
            "compatibilityMirror": {
              "const": null
            },
            "writePolicy": {
              "const": "declared-bindings-only"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "semanticIndexAllowedFields": {
      "const": [
        "generation",
        "builtAt",
        "sourceDigest",
        "dependencySetDigest",
        "dirtyCacheFlag",
        "producerId",
        "producerVersion"
      ]
    },
    "semanticIndexReservation": {
      "type": "object",
      "required": [
        "status",
        "authorityFootprint",
        "chunkRows",
        "futureBinding",
        "declaredBindings"
      ],
      "properties": {
        "status": {
          "const": "reserved"
        },
        "authorityFootprint": {
          "type": "object",
          "required": [
            "surfaces",
            "passCondition",
            "nonZeroDisposition",
            "rebuildTarget",
            "classification"
          ],
          "properties": {
            "surfaces": {
              "type": "array",
              "const": [
                {
                  "id": "metadataRows",
                  "relation": "narrative_semantic_index_metadata",
                  "rowSet": "all-project-rows",
                  "predicate": "project_id = ?1"
                },
                {
                  "id": "activeD1HeadRows",
                  "relation": "narrative_dependency_declaration_heads",
                  "rowSet": "active-sealed-D1-heads",
                  "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
                },
                {
                  "id": "v1EdgeRows",
                  "relation": "narrative_dependency_edges",
                  "rowSet": "V1-edges",
                  "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
                },
                {
                  "id": "consumerFreshnessRows",
                  "relation": "narrative_consumer_freshness",
                  "rowSet": "consumer-freshness",
                  "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
                }
              ]
            },
            "passCondition": {
              "const": "unrecognized-all-zero"
            },
            "nonZeroDisposition": {
              "const": "manual-terminal"
            },
            "rebuildTarget": {
              "const": "forbidden"
            },
            "classification": {
              "const": "exclude-only-validated-declared-bindings"
            }
          },
          "additionalProperties": false
        },
        "chunkRows": {
          "type": "object",
          "required": [
            "allowed",
            "classification",
            "narrativeDependencyAuthorityClaim"
          ],
          "properties": {
            "allowed": {
              "const": true
            },
            "classification": {
              "const": "rebuildable-acceleration"
            },
            "narrativeDependencyAuthorityClaim": {
              "const": "forbidden"
            }
          },
          "additionalProperties": false
        },
        "futureBinding": {
          "type": "object",
          "required": [
            "status",
            "approvalGate",
            "firstCandidate",
            "mapping",
            "unapprovedDecisions",
            "scope"
          ],
          "properties": {
            "status": {
              "const": "dormant"
            },
            "approvalGate": {
              "const": "NIR-1"
            },
            "firstCandidate": {
              "const": "one-shared-producer"
            },
            "mapping": {
              "type": "object",
              "required": [
                "metadata.index_key",
                "metadata.generation",
                "metadata.dependency_set_digest"
              ],
              "properties": {
                "metadata.index_key": {
                  "const": "D1.consumer_key=freshness.consumer_key"
                },
                "metadata.generation": {
                  "const": "active-sealed-D1-head.consumer-scoped-producer_generation"
                },
                "metadata.dependency_set_digest": {
                  "const": "active-sealed-D1-set.digest"
                }
              },
              "additionalProperties": false
            },
            "unapprovedDecisions": {
              "const": [
                "fixed-keys",
                "producer-registry",
                "source-identities",
                "writers",
                "D1-declarations",
                "metadata-migration",
                "restore-invalidation",
                "reserved-to-declared-activation",
                "producer-granularity",
                "metadata-producer-identity-composition",
                "dirty-pending-semantics",
                "Codex-source-granularity"
              ]
            },
            "scope": {
              "const": "all-other-producers"
            }
          },
          "additionalProperties": false
        },
        "declaredBindings": {
          "const": [
            {
              "consumerKey": "nir1-reviewed-chronicle:v1",
              "producerId": "nir1-reviewed-chronicle-v1",
              "producerVersion": "nir1-reviewed-chronicle/v1",
              "registryGeneration": "nir1-reviewed-chronicle/v1",
              "declarationSetGeneration": "positive-monotonic-per-project",
              "metadataBinding": {
                "indexKey": "equals-consumer-key",
                "producerId": "explicit-exact-producer-id",
                "producerVersion": "explicit-exact-producer-version",
                "generation": "equals-active-sealed-D1-head-consumer-scoped-generation",
                "dependencySetDigest": "equals-active-sealed-D1-set-digest"
              },
              "eligibilitySource": {
                "kind": "nir1-chronicle-eligibility-set",
                "keyFormat": "project:nir1-chronicle-eligibility:{projectId}",
                "digestBasis": "sorted-current-revision-envelope-and-own-human-decision-identities",
                "freshnessInDigest": "forbidden"
              },
              "writer": {
                "module": "src-tauri/crates/grimodex-db/src/narrative_extraction/nir1_chronicle_index/publish.rs",
                "symbol": "publish_chronicle_index_build_in_tx"
              },
              "recognizedUnavailable": "rebuildable-not-query-usable",
              "queryUsability": "canonical-fresh-and-clean-current-native-proof",
              "unknownOrIncoherentBinding": "manual-terminal"
            },
            {
              "consumerKey": "nir1-reviewed-entity-relation:v1",
              "producerId": "nir1-reviewed-entity-relation-v1",
              "producerVersion": "nir1-reviewed-entity-relation/v1",
              "registryGeneration": "nir1-reviewed-entity-relation/v1",
              "declarationSetGeneration": "positive-monotonic-per-project",
              "metadataBinding": {
                "indexKey": "equals-consumer-key",
                "producerId": "explicit-exact-producer-id",
                "producerVersion": "explicit-exact-producer-version",
                "generation": "equals-active-sealed-D1-head-consumer-scoped-generation",
                "dependencySetDigest": "equals-active-sealed-D1-set-digest"
              },
              "eligibilitySource": {
                "kind": "nir1-entity-relation-eligibility-set",
                "keyFormat": "project:nir1-entity-relation-eligibility:{projectId}",
                "digestBasis": "sorted-qualified-current-revision-object-revision-decision-source-token-roster",
                "freshnessInDigest": "forbidden"
              },
              "writer": {
                "module": "src-tauri/crates/grimodex-db/src/narrative_extraction/nir1_entity_relation_index.rs",
                "symbol": "publish_nir1_entity_relation_index_in_tx"
              },
              "recognizedUnavailable": "rebuildable-not-query-usable",
              "queryUsability": "canonical-fresh-and-clean-current-native-proof",
              "unknownOrIncoherentBinding": "manual-terminal"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "forbiddenFreshnessClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "secondaryFreshnessAuthorityPolicy": {
      "const": "forbid"
    }
  },
  "additionalProperties": false
}
