{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimodex.dev/schema/narrative/retrieval-disclosure-v1.json",
  "type": "object",
  "required": ["schemaVersion", "contract", "admissionStage", "phaseResolutionModes", "contextFields", "rejectionRules", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "narrative-retrieval-disclosure" },
    "admissionStage": { "const": "before-ranking-candidate-admission" },
    "phaseResolutionModes": { "const": ["reading", "story", "auto"] },
    "contextFields": { "type": "array", "minItems": 10, "items": { "type": "string", "minLength": 1 } },
    "rejectionRules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "fixtures": { "type": "array", "minItems": 7, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
