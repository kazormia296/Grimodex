          "expectedDisposition": "accept",
          "changedPathClasses": [
            "scope-affecting"
          ]
        },
        {
          "id": "mixed-title-secret-uses-scope-override",
          "changedPaths": [
            "/title",
            "/disclosure/secret"
          ],
          "expectedDerivationKind": "scope-override",
          "expectedDisposition": "accept",
          "changedPathClasses": [
            "projection-only",
            "scope-affecting"
          ]
        },
        {
          "id": "mixed-note-reveal-document-uses-scope-override",
          "changedPaths": [
            "/note",
            "/disclosure/revealDocumentRef"
          ],
          "expectedDerivationKind": "scope-override",
          "expectedDisposition": "accept",
          "changedPathClasses": [
            "projection-only",
            "scope-affecting"
          ]
        },
        {
          "id": "unsupported-path-refused",
          "changedPaths": [
            "/semanticPayload/actuality"
          ],
          "expectedDisposition": "reject"
        }
      ]
