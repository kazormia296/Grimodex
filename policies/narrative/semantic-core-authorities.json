{
  "schemaVersion": 1,
  "contract": "narrative-semantic-core-authorities",
  "authorities": [
    {
      "concern": "evidence-freshness",
      "canonicalAuthority": "C2 consumer freshness evaluator",
      "compatibilityMirror": "legacy projection freshness",
      "writePolicy": "canonical-only"
    },
    {
      "concern": "semantic-assessment",
      "canonicalAuthority": "reconciler proposal revision",
      "compatibilityMirror": null,
      "writePolicy": "proposal-only"
    },
    {
      "concern": "domain-state",
      "canonicalAuthority": "typed native writer",
      "compatibilityMirror": "browser mock mirror",
      "writePolicy": "typed-writer-only"
    },
    {
      "concern": "search-generation",
      "canonicalAuthority": "none (semantic-index reserved; NIR-1 pending)",
      "compatibilityMirror": null,
      "writePolicy": "reserved-no-writer"
    },
    {
      "concern": "review",
      "canonicalAuthority": "decision ledger",
      "compatibilityMirror": "none",
      "writePolicy": "decision-only"
    },
    {
      "concern": "maintenance-finding-observation",
      "canonicalAuthority": "freshness-run-publish-transaction",
      "compatibilityMirror": null,
      "writePolicy": "evaluator-publish-only"
    },
    {
      "concern": "maintenance-terminal-finding-observation",
      "canonicalAuthority": "maintenance-run-finalization-transaction",
      "compatibilityMirror": null,
      "writePolicy": "maintenance-finalization-only"
    },
    {
      "concern": "maintenance-attention",
      "canonicalAuthority": "attention-typed-writer",
      "compatibilityMirror": null,
      "writePolicy": "typed-writer-only"
    }
  ],
  "semanticIndexAllowedFields": [
    "generation",
    "builtAt",
    "sourceDigest",
    "dependencySetDigest",
    "dirtyCacheFlag"
  ],
  "semanticIndexReservation": {
    "status": "reserved",
    "authorityFootprint": {
      "surfaces": [
        {
          "id": "metadataRows",
          "relation": "narrative_semantic_index_metadata",
          "rowSet": "all-project-rows",
          "predicate": "project_id = ?1"
        },
        {
          "id": "activeD1HeadRows",
          "relation": "narrative_dependency_declaration_heads",
          "rowSet": "active-sealed-D1-heads",
          "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
        },
        {
          "id": "v1EdgeRows",
          "relation": "narrative_dependency_edges",
          "rowSet": "V1-edges",
          "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
        },
        {
          "id": "consumerFreshnessRows",
          "relation": "narrative_consumer_freshness",
          "rowSet": "consumer-freshness",
          "predicate": "project_id = ?1 AND consumer_kind = 'semantic-index'"
        }
      ],
      "passCondition": "all-zero",
      "nonZeroDisposition": "manual-terminal",
      "rebuildTarget": "forbidden"
    },
    "chunkRows": {
      "allowed": true,
      "classification": "rebuildable-acceleration",
      "narrativeDependencyAuthorityClaim": "forbidden"
    },
    "futureBinding": {
      "status": "dormant",
      "approvalGate": "NIR-1",
      "firstCandidate": "one-shared-producer",
      "mapping": {
        "metadata.index_key": "D1.consumer_key=freshness.consumer_key",
        "metadata.generation": "active-sealed-D1-head.consumer-scoped-producer_generation",
        "metadata.dependency_set_digest": "active-sealed-D1-set.digest"
      },
      "unapprovedDecisions": [
        "fixed-keys",
        "producer-registry",
        "source-identities",
        "writers",
        "D1-declarations",
        "metadata-migration",
        "restore-invalidation",
        "reserved-to-declared-activation",
        "producer-granularity",
        "metadata-producer-identity-composition",
        "dirty-pending-semantics",
        "Codex-source-granularity"
      ]
    }
  },
  "forbiddenFreshnessClaims": [
    "assertion-is-authoritative-fresh",
    "assertionFresh",
    "isAuthoritativeFresh",
    "semanticTruth"
  ],
  "secondaryFreshnessAuthorityPolicy": "forbid"
}
