  "unresolvedReasons": [
    "not-provided",
    "ambiguous",
    "missing-reference",
    "unsupported-axis",
    "legacy-axis-unknown"
  ],
  "unresolvedSemantics": {
    "meaning": "constrained-but-specific-value-unresolved",
    "futureAnyPolicy": "scope-revision-required",
    "equalityPolicy": "same-scope-revision-or-stable-constraint-id",
    "reasonAloneEstablishesIdentity": false
  },
  "legalScope": {
    "allAxesRequired": true,
    "constraintsRepresentNonEmptySets": true,
    "emptyResolutionOutcome": "validation-failure",
    "intervalRequiresBoundary": true,
    "emptyReferencePolicy": "forbid"
  },
  "relations": [
    "equal",
    "contains",
    "contained-by",
    "overlaps",
    "disjoint",
    "unknown"
  ],
  "relationSemantics": {
    "classification": "strongest-established-knowledge",
    "containsIsStrict": false,
    "containedByIsStrict": false,
    "overlapsRequiresEstablishedNonEmptyIntersection": true,
    "conflictingProofPolicy": "fail-closed-contract-error"
  },
  "basicRelationFixtures": [
    {
      "id": "any-vs-any-is-equal",
      "leftKind": "any",
      "rightKind": "any",
      "expected": "equal"
    },
    {
      "id": "any-vs-exact-is-contains",
      "leftKind": "any",
      "rightKind": "exact",
      "expected": "contains"
    },
    {
      "id": "any-vs-unresolved-is-contains",
      "leftKind": "any",
      "rightKind": "unresolved",
      "expected": "contains"
    },
    {
      "id": "unresolved-vs-any-is-contained-by",
      "leftKind": "unresolved",
      "rightKind": "any",
      "expected": "contained-by"
    },
    {
      "id": "same-unresolved-reason-is-not-identity",
      "leftKind": "unresolved",
      "rightKind": "unresolved",
      "sameReason": true,
      "sameConstraintIdentity": false,
      "expected": "unknown"
    },
    {
      "id": "same-unresolved-constraint-id-is-equal",
      "leftKind": "unresolved",
      "rightKind": "unresolved",
      "sameReason": true,
      "sameConstraintIdentity": true,
      "expected": "equal"
    }
  ],
  "compositionPrecedence": [
    "any-axis-disjoint=>disjoint",
    "no-disjoint-and-any-axis-unknown=>unknown",
    "all-axes-equal=>equal",
    "all-equal-or-contains-and-at-least-one-contains=>contains",
    "all-equal-or-contained-by-and-at-least-one-contained-by=>contained-by",
    "all-intersections-non-empty-and-neither-whole-containment=>overlaps",
    "otherwise=>unknown"
  ],
  "canonicalization": {
    "digestAlgorithm": "sha256-canonical-json",
    "includes": [
      "json-key-order",
      "all-required-axis-fields",
      "explicit-inclusive-flags",
      "at-least-one-interval-boundary",
      "non-empty-references",
      "axis-kind-constraint-kind-consistency"
    ],
    "excludes": [
      "from-before-until-order",
      "worldline-containment-or-exclusion",
      "narrative-layer-parentage",
      "cross-reference-equivalence"
    ]
  },
  "oracleContract": {
    "orderAxes": ["storyTime", "readingOrder"],
    "compareResults": [-1, 0, 1, "unresolved"],
    "revisionTokenRequired": true,
    "basisRequiredWheneverOracleOrRegistryUsed": true,
    "basisRequiredRelations": [
      "equal",
      "contains",
      "contained-by",
      "overlaps",
      "disjoint",
      "unknown"
    ],
    "structuralResultMayPersistWithoutBasis": true
  },
  "assertionScopeProfiles": [
    {
      "assertionKind": "character-state",
      "axes": {
        "scene": {
          "axisKind": "reference",
          "allowedKinds": ["any", "unresolved"]
        },
        "storyTime": {
          "axisKind": "temporal",
          "allowedKinds": ["interval", "unresolved"],
          "resolutionRequiredBy": "before-apply"
        }
      }
    },
    {
      "assertionKind": "scene-event",
      "axes": {
        "scene": {
          "axisKind": "reference",
          "allowedKinds": ["exact", "unresolved"],
          "resolutionRequiredBy": "before-review"
        }
      }
    }
  ],
  "consumerPolicies": [
    {
      "consumer": "retrieval-disclosure",
      "automaticRelations": ["equal", "contains"],
      "unknownPolicy": "reject-before-ranking"
    },
    {
      "consumer": "review-reuse",
      "automaticRelations": ["equal"],
      "unknownPolicy": "review-only"
    },
    {
      "consumer": "correction-memory",
      "automaticRelations": ["equal", "contains"],
      "additionalBasisRequired": true,
      "unknownPolicy": "review-only"
    },
    {
      "consumer": "contradiction-diagnostic",
      "automaticRelations": ["equal", "contains", "contained-by", "overlaps"],
      "unknownPolicy": "scope-unresolved-conflict-candidate"
    }
  ],
  "v1Compatibility": {
    "currentType": "src/features/narrative-semantic-core/contracts/scope.ts#NarrativeScope",
    "migrationRequiredNow": false,
    "adapterPurpose": "short-lived-code-and-fixture-compatibility",
    "ambiguousTemporalAxisPolicy": "map-both-story-time-and-reading-order-to-unresolved",
    "implicitGlobalPolicy": "forbid"
  },
  "nonEffects": [
    "truth-verdict",
    "automatic-retraction",
    "automatic-merge-or-split",
    "automatic-domain-mutation"
  ]
}
