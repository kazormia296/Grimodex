  "axes": [
    {
      "id": "timeline",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "worldline",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "scene",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "viewpoint",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "knowledgeHolder",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "audience",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"],
      "reservedRefs": ["reader"]
    },
    {
      "id": "narrativeLayer",
      "axisKind": "reference",
      "allowedKinds": ["any", "exact", "unresolved"]
    },
    {
      "id": "storyTime",
      "axisKind": "temporal",
      "allowedKinds": ["any", "interval", "unresolved"]
    },
    {
      "id": "readingOrder",
      "axisKind": "temporal",
      "allowedKinds": ["any", "interval", "unresolved"]
    }
